# syntax=docker/dockerfile:1

FROM oven/bun:1.4.0-alpine AS deps

WORKDIR /app
COPY . .
# Architecture tests read the plugin guides; docs are excluded from the normal build context.
COPY docs ./docs
RUN bun install --frozen-lockfile

FROM deps AS test

# Shared CI runners are slower than a dev laptop; DB tests that create schemas or pg-boss
# queues sometimes exceed Bun's 5 s default there without being wrong.
CMD ["bun", "test", "--timeout", "15000"]
