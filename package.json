{
  "name": "bulletin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "mocks/*"
  ],
  "scripts": {
    "build:apps": "bun run --cwd apps/user-app build && bun run --cwd apps/staff-app build",
    "check": "bun run typecheck && bun run lint && bun run i18n:check && bun run lint:i18n && bun run privacy:check && bun run openapi:check && bun run build:apps && bun run test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "i18n:check": "bun scripts/i18n-catalogs.ts",
    "i18n:build": "bun scripts/i18n-catalogs.ts --write",
    "lint:i18n": "bun scripts/lint-i18n-strings.ts",
    "privacy:check": "bun scripts/privacy-inventory.ts",
    "openapi:check": "bun scripts/openapi-document.ts",
    "openapi:build": "bun scripts/openapi-document.ts --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:integration": "BULLETIN_INTEGRATION=1 bun test tests/integration",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:db": "bun test tests/harness",
    "benchmark": "bun scripts/benchmark.ts",
    "search:benchmark": "bun scripts/search-benchmark.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@bulletin/cache": "workspace:*",
    "@bulletin/config": "workspace:*",
    "@bulletin/content": "workspace:*",
    "@bulletin/db": "workspace:*",
    "@bulletin/domain": "workspace:*",
    "@bulletin/flags": "workspace:*",
    "@bulletin/i18n": "workspace:*",
    "@bulletin/mock-mail": "workspace:*",
    "@bulletin/mock-push": "workspace:*",
    "@bulletin/mock-s3": "workspace:*",
    "@bulletin/storage": "workspace:*",
    "@bulletin/templates": "workspace:*",
    "@bulletin/test-utils": "workspace:*",
    "@bulletin/ui": "workspace:*",
    "@types/bun": "1.4.4",
    "jose": "6.2.16",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "@bulletin/plugin-sdk": "workspace:*",
    "valibot": "1.5.0",
    "fflate": "0.8.3"
  }
}
