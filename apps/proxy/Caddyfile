{
	admin off
	auto_https off
}

# ADR 0018 origin topology. Every public entry point is a hostname on the port in BULLETIN_HTTP_PORT (default 8080).

http://bulletin.localhost:{$BULLETIN_HTTP_PORT:8080} {
	handle /_mocks/s3/* {
		reverse_proxy s3:4001
	}

	handle /_mocks/s3 {
		redir * /_mocks/s3/ 308
	}

	handle_path /_mocks/mail/* {
		reverse_proxy mail:4002
	}

	handle /_mocks/mail {
		redir * /_mocks/mail/ 308
	}

	handle_path /_mocks/push/* {
		reverse_proxy push:4003
	}

	handle /_mocks/push {
		redir * /_mocks/push/ 308
	}

	handle_path /_mocks/webhooks/* {
		reverse_proxy webhooks:4004
	}

	handle /_mocks/webhooks {
		redir * /_mocks/webhooks/ 308
	}

	handle_path /_mocks/oembed/* {
		reverse_proxy oembed:4005
	}

	handle /_mocks/oembed {
		redir * /_mocks/oembed/ 308
	}

	handle_path /_mocks/cdn/* {
		reverse_proxy cdn:4006
	}

	handle /_mocks/cdn {
		redir * /_mocks/cdn/__ui 308
	}

	handle_path /_mocks/marketplace/* {
		reverse_proxy marketplace:4007
	}

	handle /_mocks/marketplace {
		redir * /_mocks/marketplace/ 308
	}

	handle /api/* {
		reverse_proxy user-api:3001
	}

	handle {
		reverse_proxy user-app:4321
	}
}

http://staff.bulletin.localhost:{$BULLETIN_HTTP_PORT:8080} {
	handle /api/* {
		reverse_proxy staff-api:3002
	}

	handle {
		reverse_proxy staff-app:5173
	}
}

# Attachments, avatars and proxied images (ADR 0019). Public presigned URLs point at this
# origin; Caddy adds the headers that make arbitrary user content inert in a browser.
http://files.bulletin.localhost:{$BULLETIN_HTTP_PORT:8080} {
	handle /health/* {
		reverse_proxy user-api:3001
	}

	# Presigned S3 paths keep their full path: the signature covers /_mocks/s3/... and the
	# upstream mock expects the same base path (compose sets MOCK_BASE_PATH).
	handle /_mocks/s3/* {
		reverse_proxy s3:4001
	}

	handle /_mocks/s3 {
		redir * /_mocks/s3/ 308
	}

	header {
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox; default-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Plugin iframe apps (ADR 0009) are served by the sandbox host. The admin/internal hook API
# is not routable from the public plugin origin.
http://plugins.bulletin.localhost:{$BULLETIN_HTTP_PORT:8080} {
	handle /apps/* {
		reverse_proxy plugin-host:3004
	}

	handle /health/* {
		reverse_proxy plugin-host:3004
	}

	handle {
		respond "Not found" 404
	}
}

# DarkAuth issuer (ADR 0004); backed by darkauth-mock locally.
http://auth.bulletin.localhost:{$BULLETIN_HTTP_PORT:8080} {
	reverse_proxy darkauth-mock:3020
}
