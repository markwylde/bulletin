{
  "id": "sandbox-demo",
  "name": "Sandbox demo plugin",
  "version": "0.0.0",
  "sdkVersion": "^2.0.0",
  "entry": "server.ts",
  "capabilities": [
    "template",
    "enricher",
    "filter",
    "veto",
    "route",
    "client",
    "events",
    "jobs",
    "db",
    "egress"
  ],
  "egressHosts": ["example.com"],
  "migrations": ["migrations/0001_notes.sql"],
  "templateFragments": [
    {
      "name": "post.userbar",
      "kind": "hook",
      "body": "<span class=\"bl-demo-userbar\" data-demo-userbar>{% island \"PluginApp\", pluginId: \"sandbox-demo\", version: \"1\", app: \"client/index.html\", viewJson: \"{}\" %}</span>"
    }
  ],
  "enrichers": [
    {
      "hook": "home.view",
      "fields": ["tipTotal"],
      "deps": ["tips"]
    }
  ],
  "filters": [
    {
      "hook": "post.write",
      "priority": 10
    }
  ],
  "vetoes": [
    {
      "hook": "post.write",
      "reasonKey": "plugin.demo.veto",
      "failMode": "open"
    }
  ],
  "events": ["topic.created"],
  "contentExtensions": ["tip"],
  "routes": [
    {
      "path": "tip",
      "kind": "api"
    }
  ],
  "jobs": [
    {
      "name": "leaderboard"
    }
  ],
  "clientApps": [
    {
      "name": "tip-jar",
      "entry": "client/index.html",
      "hooks": ["post.userbar"]
    }
  ],
  "i18n": {
    "en": {
      "plugin.demo.veto": "The demo plugin rejected this post"
    }
  },
  "forumActions": ["can_tip"],
  "flags": ["tip_jar"],
  "settings": {
    "id": "sandbox-demo",
    "extensionPoint": "acp.groups.settings",
    "sections": [
      {
        "id": "main",
        "titleKey": "plugin.demo.settings.title",
        "fields": [
          {
            "id": "greeting",
            "type": "text",
            "labelKey": "plugin.demo.greeting",
            "required": true,
            "maxLength": 40
          }
        ]
      }
    ]
  }
}
