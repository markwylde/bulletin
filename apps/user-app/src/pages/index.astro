---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../catalogs.ts";

const messages = JSON.stringify(USER_CATALOGS);
const t = createServerT("en", { shipped: USER_CATALOGS });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("common.siteName")}</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f4f6f9;
        color: #1c2430;
      }

      main {
        width: min(100% - 2rem, 40rem);
        padding: 1.5rem;
        border: 1px solid #dce1e8;
        border-radius: 0.75rem;
        background: #ffffff;
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
      }

      p {
        margin: 0;
        color: #5c6878;
      }

      .auth {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.25rem;
        min-height: 2.75rem;
      }

      .auth button,
      .reauth button {
        min-height: 2.75rem;
        padding: 0.6rem 1.1rem;
        border: 0;
        border-radius: 0.5rem;
        background: #3157c7;
        color: #ffffff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }

      .auth button:disabled,
      .reauth button:disabled {
        opacity: 0.6;
        cursor: progress;
      }

      .auth button:focus-visible,
      .reauth button:focus-visible {
        outline: 3px solid #93a7ea;
        outline-offset: 2px;
      }

      .reauth {
        margin-top: 1rem;
        padding: 0.9rem;
        border: 1px solid #dce1e8;
        border-radius: 0.5rem;
      }

      .reauth-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.75rem;
      }

      .auth [data-auth-error] {
        color: #a02a2a;
      }

      [hidden] {
        display: none !important;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background: #141a22;
          color: #e7ecf3;
        }

        main {
          background: #1d2530;
          border-color: #303b49;
        }

        p {
          color: #93a0b1;
        }

        .auth [data-auth-error] {
          color: #ff9d9d;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1 data-i18n="user.placeholder.title">{t("user.placeholder.title")}</h1>
      <p data-i18n="user.placeholder.body">{t("user.placeholder.body")}</p>
      <div class="auth" data-auth data-auth-state="loading">
        <button
          type="button"
          data-login
          data-i18n="auth.login"
          hidden>{t("auth.login")}</button
        >
        <p data-signed-in hidden>
          <span data-i18n="auth.signedIn">{t("auth.signedIn")}</span>
          <span data-display-name></span>
        </p>
        <button type="button" data-logout data-i18n="auth.logout" hidden
          >{t("auth.logout")}</button
        >
        <p data-auth-error data-i18n="auth.loginError" hidden>{t("auth.loginError")}</p>
      </div>
      <div class="reauth" data-reauth hidden>
        <p data-i18n="auth.reauthPrompt">{t("auth.reauthPrompt")}</p>
        <div class="reauth-actions">
          <button type="button" data-reauth-continue data-i18n="auth.continue"
            >{t("auth.continue")}</button
          >
          <button type="button" data-resume data-i18n="auth.resume" hidden
            >{t("auth.resume")}</button
          >
        </div>
      </div>
    </main>
    <script type="application/json" id="i18n-catalog" set:html={messages}></script>
    <script is:inline>
      (() => {
        const data = JSON.parse(document.getElementById("i18n-catalog").textContent);
        const params = new URLSearchParams(window.location.search);
        const bp = /(?:^|;\s*)bp=([^;]+)/.exec(document.cookie)?.[1]?.split(".")[0];
        const requested = params.get("lang") ?? bp;
        const locale = ["en", "es", "fr"].includes(requested) ? requested : "en";

        document.documentElement.lang = locale;

        for (const element of document.querySelectorAll("[data-i18n]")) {
          const key = element.getAttribute("data-i18n");
          const value = data[locale]?.[key] ?? data.en[key];

          if (value !== undefined) {
            element.textContent = value;
          }
        }
      })();
    </script>
    <script>
      import {
        beginLogin,
        clearStashedRequest,
        createAuthFetch,
        loadSession,
        logout,
        reauthUrl,
        takeStashedRequest,
      } from "@bulletin/domain/auth/browser";

      const root = document.querySelector<HTMLElement>("[data-auth]");
      const loginButton = document.querySelector<HTMLButtonElement>("[data-login]");
      const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");
      const signedIn = document.querySelector<HTMLElement>("[data-signed-in]");
      const displayName = document.querySelector<HTMLElement>("[data-display-name]");
      const error = document.querySelector<HTMLElement>("[data-auth-error]");
      const reauthBox = document.querySelector<HTMLElement>("[data-reauth]");
      const continueButton = document.querySelector<HTMLButtonElement>("[data-reauth-continue]");
      const resumeButton = document.querySelector<HTMLButtonElement>("[data-resume]");

      const showError = (): void => {
        if (error !== null) {
          error.hidden = false;
        }
      };

      const updateReauthPrompt = (authenticated: boolean): void => {
        const stashed = takeStashedRequest();

        if (reauthBox !== null) {
          reauthBox.hidden = stashed === null;
        }

        if (resumeButton !== null) {
          resumeButton.hidden = !(authenticated && stashed !== null);
        }
      };

      const authFetch = createAuthFetch({
        onReauthRequired: () => {
          updateReauthPrompt(false);
        },
      });

      async function refresh(): Promise<void> {
        try {
          const session = await loadSession();

          if (session.authenticated) {
            root?.setAttribute("data-auth-state", "authenticated");

            if (loginButton !== null) {
              loginButton.hidden = true;
            }

            if (logoutButton !== null) {
              logoutButton.hidden = false;
            }

            if (signedIn !== null) {
              signedIn.hidden = false;
            }

            if (displayName !== null) {
              displayName.textContent = session.displayName ?? "";
            }

            updateReauthPrompt(true);
            return;
          }

          root?.setAttribute("data-auth-state", "guest");

          if (loginButton !== null) {
            loginButton.hidden = false;
          }

          if (logoutButton !== null) {
            logoutButton.hidden = true;
          }

          updateReauthPrompt(false);
        } catch {
          root?.setAttribute("data-auth-state", "error");
          showError();

          if (loginButton !== null) {
            loginButton.hidden = false;
          }
        }
      }

      if (loginButton !== null) {
        loginButton.addEventListener("click", () => {
          loginButton.disabled = true;
          void beginLogin().catch(() => {
            showError();
            loginButton.disabled = false;
          });
        });
      }

      if (logoutButton !== null) {
        logoutButton.addEventListener("click", () => {
          logoutButton.disabled = true;
          void logout();
        });
      }

      if (continueButton !== null) {
        continueButton.addEventListener("click", () => {
          window.location.assign(reauthUrl(`${window.location.pathname}${window.location.search}`));
        });
      }

      if (resumeButton !== null) {
        resumeButton.addEventListener("click", () => {
          const stashed = takeStashedRequest();

          if (stashed === null) {
            return;
          }

          clearStashedRequest();
          resumeButton.disabled = true;
          void authFetch(stashed.url, {
            method: stashed.method,
            headers: stashed.headers,
            body: stashed.body,
          })
            .then((response) => {
              if (response.ok) {
                window.location.reload();
              }
            })
            .finally(() => {
              resumeButton.disabled = false;
              updateReauthPrompt(true);
            });
        });
      }

      if (new URLSearchParams(window.location.search).has("auth_error")) {
        showError();
      }

      void refresh();
    </script>
  </body>
</html>
