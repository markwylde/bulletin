---
import { createServerT } from "@bulletin/i18n";
import { cacheRuntime } from "../cache-runtime.ts";
import { USER_CATALOGS } from "../catalogs.ts";
import { homeContract } from "../contracts.ts";
import { readSql } from "../db.ts";
import { renderHomeRoute } from "../home/route.ts";
import { applyCacheHeaders, isNotModified, requestHasSession } from "../http/cache.ts";
import ThemeLayout from "../layouts/ThemeLayout.astro";
import { loadPluginsGeneration, requestColourScheme } from "../theme/render.ts";

const messages = JSON.stringify(USER_CATALOGS);
const sql = readSql();
const pluginsGeneration = await loadPluginsGeneration(sql);
const locale = Astro.locals.locale ?? "en";
const localeSource = Astro.locals.localeSource ?? "guest";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const dev = import.meta.env.DEV;
const nodeEnv = process.env.NODE_ENV === "production" ? "production" : "development";
const session = Astro.locals.session ?? null;
const visitor = session === null ? "guest" : "member";
const runtime = await cacheRuntime(sql);
// Board data is loaded inside the route's prepare, after the cache captures tag versions.
const result = await renderHomeRoute({
  sql,
  themeId: Astro.locals.themeId,
  preview: Astro.locals.previewTheme === true,
  locale,
  translate,
  session,
  // The dev-only benchmark turns this into a fresh variant (task 7.1).
  ...(() => {
    const bench = Astro.url.searchParams.get("bench");

    return bench !== null && /^\d{1,10}$/.test(bench) ? { bench: Number(bench) } : {};
  })(),
  pluginsGeneration: pluginsGeneration,
  colourScheme:
    Astro.locals.colourScheme ?? requestColourScheme(Astro.request.headers.get("cookie")),
  cache: runtime.cache,
  tagVersions: runtime.tags,
  // The shell differs for members, so the response ETag must cover it.
  shell: { visitor, localeSource: localeSource === "member" ? "member" : "guest" },
});
const headers = new Headers();

applyCacheHeaders(headers, {
  cdnCacheable: homeContract.cdnCacheable,
  hasSession: requestHasSession(Astro.request.headers.get("cookie"), nodeEnv),
  hasUnlockGrant: false,
  tags: result.tags,
  etag: result.etag,
  dev,
  status: result.cache,
  key: result.variant,
});

for (const [name, value] of headers) {
  Astro.response.headers.set(name, value);
}

if (isNotModified(Astro.request.headers.get("if-none-match"), result.etag)) {
  return new Response(null, { status: 304, headers });
}
---

<ThemeLayout
  colourScheme={Astro.locals.colourScheme ?? "system"}
  title={result.title}
  locale={locale}
  body={result.html}
  seo={result.seo}
  visitor={visitor}
  serverLocale={locale}
  localeSource={localeSource}
>
  <div hidden data-i18n-catalog>{messages}</div>
  <script>import "../locale-bootstrap.ts";</script>
  <script>import "../announcements/client.ts";</script>
  <script>import "../forums/redirects-client.ts";</script>
  <script>
    import { applyBoardDefaultLocale, applyBoardState, fetchBoardState } from "../board-client.ts";

    void fetchBoardState().then((state) => {
      if (state !== null) {
        applyBoardDefaultLocale(document, state);
      }

      applyBoardState(document, state);
    });
  </script>
</ThemeLayout>
