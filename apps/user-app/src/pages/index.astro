---
import { createServerT } from "@bulletin/i18n";
import { cacheRuntime } from "../cache-runtime.ts";
import { USER_CATALOGS } from "../catalogs.ts";
import { homeContract } from "../contracts.ts";
import { readSql } from "../db.ts";
import { renderHomeRoute } from "../home/route.ts";
import { applyCacheHeaders, isNotModified, requestHasSession } from "../http/cache.ts";
import ThemeLayout from "../layouts/ThemeLayout.astro";
import { PLUGIN_GENERATION, requestColourScheme } from "../theme/render.ts";

const messages = JSON.stringify(USER_CATALOGS);
const sql = readSql();
const locale = Astro.locals.locale ?? "en";
const localeSource = Astro.locals.localeSource ?? "guest";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const dev = import.meta.env.DEV;
const nodeEnv = process.env.NODE_ENV === "production" ? "production" : "development";
const session = Astro.locals.session ?? null;
const visitor = session === null ? "guest" : "member";
const runtime = await cacheRuntime(sql);
// Board data is loaded inside the route's prepare, after the cache captures tag versions.
const result = await renderHomeRoute({
  sql,
  locale,
  translate,
  pluginsGeneration: PLUGIN_GENERATION,
  colourScheme: requestColourScheme(Astro.request.headers.get("cookie")),
  cache: runtime.cache,
  tagVersions: runtime.tags,
  // The shell differs for members, so the response ETag must cover it.
  shell: { visitor, localeSource: localeSource === "member" ? "member" : "guest" },
});
const headers = new Headers();

applyCacheHeaders(headers, {
  cdnCacheable: homeContract.cdnCacheable,
  hasSession: requestHasSession(Astro.request.headers.get("cookie"), nodeEnv),
  hasUnlockGrant: false,
  tags: result.tags,
  etag: result.etag,
  dev,
  status: result.cache,
  key: result.variant,
});

for (const [name, value] of headers) {
  Astro.response.headers.set(name, value);
}

if (isNotModified(Astro.request.headers.get("if-none-match"), result.etag)) {
  return new Response(null, { status: 304, headers });
}
---

<ThemeLayout
  title={result.title}
  locale={locale}
  body={result.html}
  visitor={visitor}
  serverLocale={locale}
  localeSource={localeSource}
>
  <div hidden data-i18n-catalog>{messages}</div>
  <script>import "../locale-bootstrap.ts";</script>
  <script>
    import { applyBoardDefaultLocale, applyBoardState, fetchBoardState } from "../board-client.ts";

    void fetchBoardState().then((state) => {
      if (state !== null) {
        applyBoardDefaultLocale(document, state);
      }

      applyBoardState(document, state);
    });
  </script>
  <script>
    import {
      beginLogin,
      clearStashedRequest,
      createAuthFetch,
      loadSession,
      logout,
      reauthUrl,
      ReauthRequiredError,
      takeStashedRequest,
    } from "@bulletin/domain/auth/browser";
    import { resumeStashedRequest } from "../resume.ts";

    const root = document.querySelector<HTMLElement>("[data-auth]");
    const loginButton = document.querySelector<HTMLButtonElement>("[data-login]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");
    const signedIn = document.querySelector<HTMLElement>("[data-signed-in]");
    const displayName = document.querySelector<HTMLElement>("[data-display-name]");
    const error = document.querySelector<HTMLElement>("[data-auth-error]");
    const logoutError = document.querySelector<HTMLElement>("[data-logout-error]");
    const reauthBox = document.querySelector<HTMLElement>("[data-reauth]");
    const continueButton = document.querySelector<HTMLButtonElement>("[data-reauth-continue]");
    const resumeButton = document.querySelector<HTMLButtonElement>("[data-resume]");

    let currentMemberId: string | null = null;
    const applyLocale = (window as unknown as { __bulletinApplyLocale?: (locale: string) => void })
      .__bulletinApplyLocale;

    const showError = (): void => {
      if (error !== null) {
        error.hidden = false;
      }
    };

    const updateReauthPrompt = (authenticated: boolean): void => {
      const stashed = takeStashedRequest(currentMemberId);

      if (reauthBox !== null) {
        reauthBox.hidden = stashed === null;
      }

      if (resumeButton !== null) {
        resumeButton.hidden = !(authenticated && stashed !== null);
      }
    };

    const authFetch = createAuthFetch({
      ownerId: () => currentMemberId,
      onReauthRequired: () => {
        updateReauthPrompt(false);
      },
    });

    async function refresh(): Promise<void> {
      try {
        const session = await loadSession();
        currentMemberId = session.authenticated ? (session.memberId ?? null) : null;

        if (session.authenticated) {
          document.documentElement.dataset.localeSource = "member";

          if (session.locale !== null) {
            document.documentElement.dataset.serverLocale = session.locale;
            applyLocale?.(session.locale);
          }

          root?.setAttribute("data-auth-state", "authenticated");

          if (loginButton !== null) {
            loginButton.hidden = true;
          }

          if (logoutButton !== null) {
            logoutButton.hidden = false;
          }

          if (signedIn !== null) {
            signedIn.hidden = false;
          }

          if (displayName !== null) {
            displayName.textContent = session.displayName ?? "";
          }

          updateReauthPrompt(true);
          return;
        }

        root?.setAttribute("data-auth-state", "guest");

        if (loginButton !== null) {
          loginButton.hidden = false;
        }

        if (logoutButton !== null) {
          logoutButton.hidden = true;
        }

        updateReauthPrompt(false);
      } catch (error) {
        if (error instanceof ReauthRequiredError) {
          window.location.assign(
            reauthUrl(`${window.location.pathname}${window.location.search}`),
          );
          return;
        }

        root?.setAttribute("data-auth-state", "error");
        showError();

        if (loginButton !== null) {
          loginButton.hidden = false;
        }
      }
    }

    if (loginButton !== null) {
      loginButton.addEventListener("click", () => {
        loginButton.disabled = true;
        void beginLogin().catch(() => {
          showError();
          loginButton.disabled = false;
        });
      });
    }

    if (logoutButton !== null) {
      logoutButton.addEventListener("click", () => {
        logoutButton.disabled = true;
        void logout().then((ok) => {
          if (!ok) {
            if (logoutError !== null) {
              logoutError.hidden = false;
            }

            logoutButton.disabled = false;
          }
        });
      });
    }

    if (continueButton !== null) {
      continueButton.addEventListener("click", () => {
        window.location.assign(reauthUrl(`${window.location.pathname}${window.location.search}`));
      });
    }

    if (resumeButton !== null) {
      resumeButton.addEventListener("click", () => {
        resumeButton.disabled = true;
        void resumeStashedRequest({
          take: () => takeStashedRequest(currentMemberId),
          clear: () => clearStashedRequest(),
          fetch: authFetch,
        })
          .then((result) => {
            if (result === "success") {
              window.location.reload();
            }
          })
          .finally(() => {
            resumeButton.disabled = false;
            updateReauthPrompt(true);
          });
      });
    }

    if (new URLSearchParams(window.location.search).has("auth_error")) {
      showError();
    }

    void refresh();
  </script>
</ThemeLayout>
