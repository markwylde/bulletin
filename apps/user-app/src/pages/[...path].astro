---
import { createServerT } from "@bulletin/i18n";
import { cacheRuntime } from "../cache-runtime.ts";
import { USER_CATALOGS } from "../catalogs.ts";
import { demoContract } from "../contracts.ts";
import { readSql } from "../db.ts";
import { demoEnabled } from "../demo/enabled.ts";
import { renderDemoRoute } from "../demo/route.ts";
import { loadViewerFlags } from "../flags.ts";
import ThemeLayout from "../layouts/ThemeLayout.astro";
import {
  boardNameFrom,
  loadActiveTheme,
  PLUGIN_GENERATION,
  renderThemedPage,
  requestColourScheme,
} from "../theme/render.ts";

// The rest route serves the dev-only demo (`/_demo/<id>`, which Astro cannot route directly
// because of the underscore) and the themed 404 for every other unknown path.
const sql = readSql();
const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
const session = Astro.locals.session ?? null;
const demoMatch = /^_demo\/([^/]+)\/?$/.exec(Astro.params.path ?? "");

let status = 404;
let pageTitle = translate("theme.error.title");
let body: string;

if (demoEnabled(process.env.NODE_ENV) && demoMatch !== null) {
  const [flags, theme, runtime] = await Promise.all([
    loadViewerFlags(sql, session),
    loadActiveTheme(sql),
    cacheRuntime(sql),
  ]);
  const result = await renderDemoRoute({
    sql,
    boardName,
    locale,
    translate,
    session,
    forumId: demoMatch[1] ?? "",
    showDeleted: Astro.url.searchParams.get("deleted") === "1",
    pluginsGeneration: PLUGIN_GENERATION,
    colourScheme: requestColourScheme(Astro.request.headers.get("cookie")),
    theme,
    flags,
    cache: runtime.cache,
  });

  status = result.status;
  pageTitle = result.title;
  body = result.html;
} else {
  const page = await renderThemedPage({
    sql,
    boardName,
    viewer: {
      isMember: session !== null,
      displayName: session?.displayName ?? null,
    },
    locale,
    translate,
    template: "error",
    viewModel: { code: "not_found", message: translate("theme.error.notFound") },
    breadcrumbs: [],
    route: demoContract,
  });

  body = page.html;
}

Astro.response.status = status;
Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout title={`${pageTitle} · ${boardName}`} locale={locale} body={body}>
  <script>import "../demo/client.ts";</script>
</ThemeLayout>
