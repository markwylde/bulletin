---
import { DEVELOPMENT_DEFAULTS } from "@bulletin/config/env";
import { can } from "@bulletin/domain/permissions";
import { grantPreviewTheme, verifyThemePreviewToken } from "@bulletin/domain/themes";
import { createServerT } from "@bulletin/i18n";
import { cacheRuntime } from "../cache-runtime.ts";
import { USER_CATALOGS } from "../catalogs.ts";
import { demoContract } from "../contracts.ts";
import { readSql } from "../db.ts";
import { demoEnabled } from "../demo/enabled.ts";
import { renderDemoRoute } from "../demo/route.ts";
import { applyCacheHeaders, isNotModified, requestHasSession } from "../http/cache.ts";
import ThemeLayout from "../layouts/ThemeLayout.astro";
import {
  boardNameFrom,
  loadPluginsGeneration,
  renderThemedPage,
  requestColourScheme,
} from "../theme/render.ts";

// The rest route serves the dev-only demo (`/_demo/<id>`, which Astro cannot route directly
// because of the underscore) and the themed 404 for every other unknown path.
const sql = readSql();
const pluginsGeneration = await loadPluginsGeneration(sql);
const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
const session = Astro.locals.session ?? null;
const dev = import.meta.env.DEV;
const nodeEnv = process.env.NODE_ENV === "production" ? "production" : "development";
const hasSessionCookie = requestHasSession(Astro.request.headers.get("cookie"), nodeEnv);
const demoMatch = /^_demo\/([^/]+)\/?$/.exec(Astro.params.path ?? "");
const previewMatch = /^_preview\/?$/.exec(Astro.params.path ?? "");
const headers = new Headers();

let status = 404;
let pageTitle = translate("theme.error.title");
let body: string;
let clientFlagsJson: string | undefined;
let documentTitle = `${pageTitle} · ${boardName}`;

if (previewMatch !== null) {
  const secret = process.env.SESSION_SECRET ?? DEVELOPMENT_DEFAULTS.SESSION_SECRET;
  const claims = verifyThemePreviewToken(Astro.url.searchParams.get("token"), secret);
  const requested = Astro.url.searchParams.get("return_to") ?? "/";
  const returnTo = requested.startsWith("/") && !requested.startsWith("//") ? requested : "/";
  const granted =
    claims !== null &&
    session !== null &&
    claims.memberId === session.memberId &&
    (await can(sql, session.memberId, "acp.themes")) &&
    (await grantPreviewTheme(sql, session.sessionId, claims.themeId));

  if (granted) {
    return new Response(null, {
      status: 303,
      headers: {
        location: returnTo,
        "cache-control": "private, no-store",
        "referrer-policy": "no-referrer",
      },
    });
  }

  return new Response(translate("theme.error.forbidden"), {
    status: 403,
    headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "private, no-store" },
  });
}

if (demoEnabled(process.env.NODE_ENV) && demoMatch !== null) {
  const runtime = await cacheRuntime(sql);
  const result = await renderDemoRoute({
    sql,
    themeId: Astro.locals.themeId,
    preview: Astro.locals.previewTheme === true,
    locale,
    translate,
    session,
    forumId: demoMatch[1] ?? "",
    showDeleted: Astro.url.searchParams.get("deleted") === "1",
    // The dev-only benchmark turns this into a fresh variant (task 7.1).
    ...(() => {
      const bench = Astro.url.searchParams.get("bench");

      return bench !== null && /^\d{1,10}$/.test(bench) ? { bench: Number(bench) } : {};
    })(),
    pluginsGeneration: pluginsGeneration,
    colourScheme:
    Astro.locals.colourScheme ?? requestColourScheme(Astro.request.headers.get("cookie")),
    cache: runtime.cache,
    tagVersions: runtime.tags,
  });

  applyCacheHeaders(headers, {
    cdnCacheable: demoContract.cdnCacheable,
    hasSession: hasSessionCookie,
    hasUnlockGrant: result.hasUnlockGrant,
    tags: result.tags,
    etag: result.etag,
    dev,
    status: result.cache,
    key: result.variant,
  });

  if (isNotModified(Astro.request.headers.get("if-none-match"), result.etag)) {
    return new Response(null, { status: 304, headers });
  }

  status = result.status;
  pageTitle = result.title;
  documentTitle = `${pageTitle} · ${result.boardName}`;
  body = result.html;
  clientFlagsJson = result.clientFlagsJson;
} else {
  applyCacheHeaders(headers, {
    cdnCacheable: false,
    hasSession: hasSessionCookie,
    hasUnlockGrant: false,
    tags: [],
    etag: null,
    dev,
  });

  const page = await renderThemedPage({
    sql,
    themeId: Astro.locals.themeId,
    boardName,
    locale,
    translate,
    template: "error",
    viewModel: { code: "not_found", message: translate("theme.error.notFound") },
    breadcrumbs: [],
    route: demoContract,
  });

  body = page.html;
}

Astro.response.status = status;

for (const [name, value] of headers) {
  Astro.response.headers.set(name, value);
}
---

<ThemeLayout
  colourScheme={Astro.locals.colourScheme ?? "system"}
  title={documentTitle}
  locale={locale}
  body={body}
  visitor={session === null ? "guest" : "member"}
  clientFlagsJson={clientFlagsJson}
>
  <script>import "../demo/client.ts";</script>
</ThemeLayout>
