---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../catalogs.ts";
import { callbackContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import { boardNameFrom, renderThemedPage } from "../../theme/render.ts";

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const session = Astro.locals.session ?? null;
const rendered = await renderThemedPage({
  sql: readSql(),
  boardName: boardNameFrom(Astro.locals.board?.boardName, translate),
  locale,
  translate,
  template: callbackContract.templates.page,
  viewModel: {},
  breadcrumbs: [],
  route: callbackContract,
});

Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout
  title={translate("auth.signingIn")}
  locale={locale}
  body={rendered.html}
  visitor={session === null ? "guest" : "member"}
  robots="noindex"
>
  <script>
    import { finishLoginAndRedirect } from "@bulletin/domain/auth/browser";

    void finishLoginAndRedirect().catch(() => {
      window.location.replace("/?auth_error=1");
    });
  </script>
</ThemeLayout>
