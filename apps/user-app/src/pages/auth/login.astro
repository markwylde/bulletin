---
import { createServerT } from "@bulletin/i18n";
import { renderAuthRoute } from "../../auth/route.ts";
import { cacheRuntime } from "../../cache-runtime.ts";
import { USER_CATALOGS } from "../../catalogs.ts";
import { loginContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import {
  boardNameFrom,
  PLUGIN_GENERATION,
  requestColourScheme,
} from "../../theme/render.ts";

const sql = readSql();
const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const session = Astro.locals.session ?? null;
const runtime = await cacheRuntime(sql);
const rendered = await renderAuthRoute({
  sql,
  themeId: Astro.locals.themeId,
  preview: Astro.locals.previewTheme === true,
  boardName: boardNameFrom(Astro.locals.board?.boardName, translate),
  locale,
  translate,
  template: loginContract.templates.page,
  contract: loginContract,
  pluginsGeneration: PLUGIN_GENERATION,
  colourScheme: requestColourScheme(Astro.request.headers.get("cookie")),
  cache: runtime.cache,
  shell: { visitor: session === null ? "guest" : "member" },
});

// A sign-in page is never shared or cached.
Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout
  title={translate("auth.login")}
  locale={locale}
  body={rendered.html}
  visitor={session === null ? "guest" : "member"}
>
  <script>
    import { beginLogin } from "@bulletin/domain/auth/browser";

    const button = document.querySelector<HTMLButtonElement>("[data-login]");
    const error = document.querySelector<HTMLElement>("[data-auth-error]");

    button?.addEventListener("click", () => {
      button.disabled = true;
      const returnTo = new URLSearchParams(window.location.search).get("return_to") ?? "/";

      void beginLogin({ returnTo }).catch(() => {
        button.disabled = false;

        if (error !== null) {
          error.hidden = false;
        }
      });
    });

    if (button !== null) {
      button.dataset.loginReady = "true";
    }
  </script>
</ThemeLayout>
