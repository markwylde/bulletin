---
import { createServerT } from "@bulletin/i18n";
import { accountLabels, buildAccountPage } from "../account/page.ts";
import { USER_CATALOGS } from "../catalogs.ts";
import { accountContract } from "../contracts.ts";
import { readSql } from "../db.ts";
import ThemeLayout from "../layouts/ThemeLayout.astro";
import { pageVariant, renderCachedPage } from "../theme/cached-route.ts";
import { boardNameFrom, PLUGIN_GENERATION, renderThemedPage } from "../theme/render.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent("/account")}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const sql = readSql();
const account = await buildAccountPage({
  sql,
  memberId: session.memberId,
  locale,
  translate,
});

if (account === null) {
  return Astro.redirect(loginUrl, 303);
}

const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
// A personal, no-store page: the shared pipeline runs but retains nothing (ADR 0006).
const rendered = await renderCachedPage({
  tags: [`member:${session.memberId}`],
  cache: null,
  tagVersions: null,
  shell: { visitor: "member", authState: "authenticated" },
  prepare: async () => ({
    variant: pageVariant({
      route: accountContract.route,
      visibilityKey: "member",
      theme: null,
      pluginsGeneration: PLUGIN_GENERATION,
      locale,
      colourScheme: "system",
      renderFlagsHash: "",
    }),
    data: undefined,
  }),
  render: async () => {
    const page = await renderThemedPage({
      sql,
      boardName,
      locale,
      translate,
      template: "account",
      viewModel: account.viewModel,
      breadcrumbs: account.breadcrumbs,
      route: accountContract,
    });

    return { html: page.html, errors: page.errors };
  },
});

// A personal, uncached page (ADR 0006).
Astro.response.headers.set("cache-control", "private, no-store");
const labels = accountLabels(translate);
---

<ThemeLayout
  title={`${account.title} · ${boardName}`}
  locale={locale}
  body={rendered.html}
  authState="authenticated"
  visitor="member"
>
  <script type="application/json" id="account-labels" set:html={JSON.stringify(labels)}></script>
  <script>import "../account/client.ts";</script>
</ThemeLayout>
