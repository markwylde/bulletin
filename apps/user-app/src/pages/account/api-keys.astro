---
import { API_SCOPES } from "@bulletin/domain/api";
import { can } from "@bulletin/domain/permissions";
import { createServerT } from "@bulletin/i18n";
import { apiKeyLabels, apiKeyScopeLabels } from "../../api-keys/page.ts";
import { USER_CATALOGS } from "../../catalogs.ts";
import { apiKeysContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import { loadViewerFlags } from "../../flags.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import { pageVariant, renderCachedPage } from "../../theme/cached-route.ts";
import { renderThemedNotFound } from "../../theme/not-found.ts";
import {
  boardNameFrom,
  loadPluginsGeneration,
  renderThemedPage,
} from "../../theme/render.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent("/account/api-keys")}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const sql = readSql();
const pluginsGeneration = await loadPluginsGeneration(sql);
const flags = await loadViewerFlags(sql, session);
const enabled = await can(sql, session.memberId, "create_personal_api_keys");
const notFound = enabled
  ? null
  : await renderThemedNotFound({
      sql,
      themeId: Astro.locals.themeId,
      locale,
      translate,
      route: apiKeysContract,
    });
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
const labels = apiKeyLabels(translate);
const scopeLabels = apiKeyScopeLabels(translate);
const rendered = await renderCachedPage({
  tags: [`member:${session.memberId}`],
  cache: null,
  tagVersions: null,
  shell: { visitor: "member", authState: "authenticated" },
  prepare: async () => ({
    variant: pageVariant({
      route: apiKeysContract.route,
      visibilityKey: "member",
      theme: null,
      pluginsGeneration: pluginsGeneration,
      locale,
      colourScheme: "system",
      renderFlagsHash: flags.hash,
    }),
    data: undefined,
  }),
  render: async () => {
    if (!enabled || notFound !== null) {
      if (notFound === null) {
        throw new Error("missing not-found page");
      }

      return { html: notFound.html, errors: notFound.errors };
    }

    const themed = await renderThemedPage({
      sql,
      themeId: Astro.locals.themeId,
      boardName,
      locale,
      translate,
      template: apiKeysContract.templates.page,
      viewModel: { flags: flags.values },
      breadcrumbs: [{ label: translate("apiKeys.title"), href: null }],
      route: apiKeysContract,
    });

    return { html: themed.html, errors: themed.errors };
  },
});

if (!enabled) {
  Astro.response.status = 404;
}

Astro.response.headers.set("cache-control", "private, no-store");
const config = { labels, scopeLabels, scopes: API_SCOPES };
---

<ThemeLayout
  colourScheme={Astro.locals.colourScheme ?? "system"}
  title={`${enabled ? translate("apiKeys.title") : (notFound?.title ?? "")} · ${boardName}`}
  locale={locale}
  body={rendered.html}
  authState="authenticated"
  visitor="member"
>
  <script type="application/json" id="api-keys-config" set:html={JSON.stringify(config)}></script>
  <script>import "../../api-keys/client.ts";</script>
</ThemeLayout>
