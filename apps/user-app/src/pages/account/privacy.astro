---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../catalogs.ts";
import { privacyContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import { buildPrivacyPage, privacyLabels } from "../../privacy/page.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import { pageVariant, renderCachedPage } from "../../theme/cached-route.ts";
import { boardNameFrom, loadPluginsGeneration, renderThemedPage } from "../../theme/render.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent("/account/privacy")}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const sql = readSql();
const pluginsGeneration = await loadPluginsGeneration(sql);
const page = await buildPrivacyPage({
  sql,
  memberId: session.memberId,
  translate,
});
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
const rendered = await renderCachedPage({
  tags: [`member:${session.memberId}`],
  cache: null,
  tagVersions: null,
  shell: { visitor: "member", authState: "authenticated" },
  prepare: async () => ({
    variant: pageVariant({
      route: privacyContract.route,
      visibilityKey: `member:${session.memberId}`,
      theme: null,
      pluginsGeneration,
      locale,
      colourScheme: "system",
      renderFlagsHash: "",
    }),
    data: undefined,
  }),
  render: async () => {
    const result = await renderThemedPage({
      sql,
      themeId: Astro.locals.themeId,
      boardName,
      locale,
      translate,
      template: privacyContract.templates.page,
      viewModel: page.viewModel,
      breadcrumbs: page.breadcrumbs,
      route: privacyContract,
    });

    return { html: result.html, errors: result.errors };
  },
});

Astro.response.headers.set("cache-control", "private, no-store");
const labels = privacyLabels(translate);
---

<ThemeLayout
  colourScheme={Astro.locals.colourScheme ?? "system"}
  title={`${page.title} · ${boardName}`}
  locale={locale}
  body={rendered.html}
  authState="authenticated"
  visitor="member"
>
  <script type="application/json" id="privacy-labels" set:html={JSON.stringify(labels)}></script>
  <script>import "../../privacy/client.ts";</script>
</ThemeLayout>
