---
import { createServerT } from "@bulletin/i18n";
import { buildNotificationsPage, parseNotificationsPageParam } from "../../account/notifications.ts";
import { USER_CATALOGS } from "../../catalogs.ts";
import { notificationsContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import { loadViewerFlags } from "../../flags.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import { pageVariant, renderCachedPage } from "../../theme/cached-route.ts";
import { renderThemedNotFound } from "../../theme/not-found.ts";
import { boardNameFrom, PLUGIN_GENERATION, renderThemedPage } from "../../theme/render.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent("/account/notifications")}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const sql = readSql();
const flags = await loadViewerFlags(sql, session);
const enabled = flags.values.notifications === true;
const requestedPage = parseNotificationsPageParam(Astro.url.searchParams.get("page"));
const page = enabled ? await buildNotificationsPage({
    sql,
    memberId: session.memberId,
    sessionId: session.sessionId,
    locale,
    translate,
    ...(requestedPage === undefined ? {} : { page: requestedPage }),
  }) : null;
const notFound = enabled
  ? null
  : await renderThemedNotFound({ sql, locale, translate, route: notificationsContract });
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);

const rendered = await renderCachedPage({
  tags: [`member:${session.memberId}`],
  cache: null,
  tagVersions: null,
  shell: { visitor: "member", authState: "authenticated" },
  prepare: async () => ({
    variant: pageVariant({
      route: notificationsContract.route,
      visibilityKey: "member",
      theme: null,
      pluginsGeneration: PLUGIN_GENERATION,
      locale,
      colourScheme: "system",
      renderFlagsHash: flags.hash,
    }),
    data: undefined,
  }),
  render: async () => {
    if (!enabled || page === null) {
      if (notFound === null) {
        throw new Error("missing not-found page");
      }

      return { html: notFound.html, errors: notFound.errors };
    }

    const themed = await renderThemedPage({
      sql,
      boardName,
      locale,
      translate,
      template: "account-notifications",
      viewModel: { title: page.title, ...page.viewModel, flags: flags.values },
      breadcrumbs: page.breadcrumbs,
      route: notificationsContract,
    });

    return { html: themed.html, errors: themed.errors };
  },
});

if (!enabled) {
  Astro.response.status = 404;
}

Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout
  title={`${enabled && page !== null ? page.title : (notFound?.title ?? "")} · ${boardName}`}
  locale={locale}
  body={rendered.html}
  authState="authenticated"
  visitor="member"
>
  <script>import "../../notifications/client.ts";</script>
</ThemeLayout>
