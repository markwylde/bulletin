---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../catalogs.ts";
import { readSql } from "../../db.ts";
import ThemeLayout from "../../layouts/ThemeLayout.astro";
import { renderSearchRoute } from "../../search/route.ts";
import { searchViewerKey } from "../../search/viewer-key.ts";

const sql = readSql();
const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const session = Astro.locals.session ?? null;
const nodeEnv = process.env.NODE_ENV === "production" ? "production" : "development";
const viewerKey = searchViewerKey(
  Astro.request,
  session !== null,
  nodeEnv,
  process.env.SESSION_SECRET ?? "bulletin-search-rate-limit",
);
const result = await renderSearchRoute({
  sql,
  themeId: Astro.locals.themeId,
  preview: Astro.locals.previewTheme === true,
  locale,
  translate,
  session,
  params: Astro.url.searchParams,
  viewerKey: viewerKey ?? null,
  mode: "new",
});

if (result.kind === "redirect") {
  return new Response(null, {
    status: result.status,
    headers: { location: result.location, "cache-control": "no-store" },
  });
}

Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.status = result.status;
---

<ThemeLayout
  colourScheme={Astro.locals.colourScheme ?? "system"}
  title={`${result.title} · ${result.boardName}`}
  locale={locale}
  body={result.html}
  visitor={session === null ? "guest" : "member"}
  serverLocale={locale}
  {...(Astro.locals.localeSource === undefined
    ? {}
    : { localeSource: Astro.locals.localeSource })}
/>
