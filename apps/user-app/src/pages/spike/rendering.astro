---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../catalogs.ts";
import { spikeRenderingContract } from "../../contracts.ts";
import { readSql } from "../../db.ts";
import { parseSpikeOptions, renderSpikePage, spikeEnabled } from "../../spike/page.ts";

// Spike S1 (ADR 0008): dev-only proof for DB templates, islands, hooks and cache variants.
const notFound = new Response("Not found", {
  status: 404,
  headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" },
});

if (!spikeEnabled(process.env.NODE_ENV, import.meta.env.DEV)) {
  return notFound;
}

const options = parseSpikeOptions(Astro.url.searchParams);

if (options === null) {
  return notFound;
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const outcome = await renderSpikePage({
  ...options,
  sql: readSql(),
  locale,
  translate,
  contract: spikeRenderingContract,
});

if (outcome.status === "not_found") {
  return notFound;
}

Astro.response.headers.set("x-spike-cache", outcome.cache);
Astro.response.headers.set("x-spike-variant", outcome.variant);
Astro.response.headers.set("x-spike-errors", String(outcome.errors.length));
// The contract decides CDN eligibility and carries the page's cache tags (ADR 0006).
Astro.response.headers.set("surrogate-key", outcome.tags.join(" "));
Astro.response.headers.set(
  "cache-control",
  spikeRenderingContract.cdnCacheable ? "public, s-maxage=15, stale-while-revalidate=15" : "private, no-store",
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:," />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{translate("spike.rendering.title")}</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 1rem;
        background: #f4f6f9;
        color: #1c2430;
      }

      main {
        width: min(100%, 40rem);
        margin: 0 auto;
      }

      .spike-page {
        display: grid;
        gap: 0.75rem;
        padding: 1rem;
        border: 1px solid #dce1e8;
        border-radius: 0.75rem;
        background: #ffffff;
      }

      .spike-page--alt {
        border-color: #3157c7;
      }

      h1 {
        margin: 0;
        font-size: 1.375rem;
      }

      p {
        margin: 0;
        line-height: 1.5;
      }

      .spike-meta {
        color: #5c6878;
        font-size: 0.875rem;
      }

      .spike-counter button {
        min-height: 2.75rem;
        padding: 0.5rem 1rem;
        border: 0;
        border-radius: 0.5rem;
        background: #3157c7;
        color: #ffffff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }

      .spike-counter button:focus-visible {
        outline: 3px solid #93a7ea;
        outline-offset: 2px;
      }

      .spike-hook {
        border-inline-start: 3px solid #3157c7;
        padding-inline-start: 0.75rem;
        color: #5c6878;
        font-size: 0.875rem;
      }

      .spike-escaped {
        overflow-wrap: anywhere;
        font-family: ui-monospace, monospace;
        font-size: 0.8125rem;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background: #141a22;
          color: #e7ecf3;
        }

        .spike-page {
          background: #1d2530;
          border-color: #303b49;
        }

        .spike-meta,
        .spike-hook {
          color: #93a0b1;
        }
      }
    </style>
  </head>
  <body>
    <main set:html={outcome.html} />
    <script>import "../../islands.ts";</script>
  </body>
</html>
