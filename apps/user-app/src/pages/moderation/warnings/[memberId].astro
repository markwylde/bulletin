---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../../catalogs.ts";
import { readSql } from "../../../db.ts";
import ThemeLayout from "../../../layouts/ThemeLayout.astro";
import { PLUGIN_GENERATION } from "../../../theme/render.ts";
import { renderStaffWarningsRoute } from "../../../warnings/route.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent(Astro.url.pathname)}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const result = await renderStaffWarningsRoute({
  sql: readSql(),
  locale,
  translate,
  session,
  pluginsGeneration: PLUGIN_GENERATION,
  colourScheme: "system",
  boardName: Astro.locals.board?.boardName ?? null,
  memberId: Astro.params.memberId ?? "",
});

Astro.response.status = result.status;
Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout title={`${result.title} · ${result.boardName}`} locale={locale} body={result.html} authState="authenticated" visitor="member">
  <script>import "../../../warnings/client.ts";</script>
</ThemeLayout>
