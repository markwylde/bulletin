---
import { createServerT } from "@bulletin/i18n";
import { USER_CATALOGS } from "../../../catalogs.ts";
import { moderationWarningsContract } from "../../../contracts.ts";
import { readSql } from "../../../db.ts";
import { loadViewerFlags } from "../../../flags.ts";
import ThemeLayout from "../../../layouts/ThemeLayout.astro";
import { pageVariant, renderCachedPage } from "../../../theme/cached-route.ts";
import { boardNameFrom, PLUGIN_GENERATION, renderThemedPage } from "../../../theme/render.ts";
import { buildStaffWarningsPage } from "../../../warnings/page.ts";

const loginUrl = `/auth/login?return_to=${encodeURIComponent(Astro.url.pathname)}`;
const session = Astro.locals.session ?? null;

if (session === null) {
  return Astro.redirect(loginUrl, 303);
}

const locale = Astro.locals.locale ?? "en";
const translate = createServerT(locale, { shipped: USER_CATALOGS });
const sql = readSql();
const flags = await loadViewerFlags(sql, session);
const memberId = Astro.params.memberId ?? "";
const page = /^\d+$/.test(memberId)
  ? await buildStaffWarningsPage({
      sql,
      actorId: session.memberId,
      memberId,
      locale,
      translate,
    })
  : null;
const boardName = boardNameFrom(Astro.locals.board?.boardName, translate);
const title = page?.title ?? translate("theme.error.title");

const rendered = await renderCachedPage({
  tags: [`member:${memberId}`],
  cache: null,
  tagVersions: null,
  shell: { visitor: "member", authState: "authenticated" },
  prepare: async () => ({
    variant: pageVariant({
      route: moderationWarningsContract.route,
      params: { memberId },
      visibilityKey: "member",
      theme: null,
      pluginsGeneration: PLUGIN_GENERATION,
      locale,
      colourScheme: "system",
      renderFlagsHash: flags.hash,
    }),
    data: undefined,
  }),
  render: async () => {
    const themed = await renderThemedPage({
      sql,
      boardName,
      locale,
      translate,
      template: page === null ? "error" : moderationWarningsContract.templates.page,
      viewModel:
        page === null
          ? { code: "forbidden", message: translate("theme.error.forbidden"), flags: flags.values }
          : { ...page.viewModel, title: page.title, flags: flags.values },
      breadcrumbs: page?.breadcrumbs ?? [],
      route: moderationWarningsContract,
    });

    return { html: themed.html, errors: themed.errors };
  },
});

Astro.response.status = page === null ? 403 : 200;
Astro.response.headers.set("cache-control", "private, no-store");
---

<ThemeLayout title={`${title} · ${boardName}`} locale={locale} body={rendered.html} authState="authenticated" visitor="member">
  <script>import "../../../warnings/client.ts";</script>
</ThemeLayout>
