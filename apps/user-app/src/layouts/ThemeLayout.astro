---
import "../theme/default.css";
import { configuredPluginOrigin } from "../plugins/config.ts";
import { pwaBuild } from "../pwa/build.ts";

interface Props {
  readonly title: string;
  readonly locale: string;
  readonly body: string;
  /** Set on pages that require a member, so the auth helpers can detect the state. */
  readonly authState?: "authenticated";
  /** Chooses the overlay (members) or the beacon (guests) for visit recording. */
  readonly visitor: "member" | "guest";
  /** The member's locale source, for the client locale/board bootstrap. */
  readonly serverLocale?: string;
  readonly localeSource?: "member" | "guest";
  readonly robots?: "noindex";
  /** Client-visible flags as JSON; only affects the island provider, never shared content. */
  readonly clientFlagsJson?: string | undefined;
  /** The member's saved scheme or the guest's `bp` choice. */
  readonly colourScheme?: "light" | "dark" | "system";
}

const {
  title,
  locale,
  body,
  authState,
  visitor,
  serverLocale,
  localeSource,
  robots,
  clientFlagsJson,
  colourScheme = "system",
} = Astro.props;
const flagsJson =
  clientFlagsJson ??
  (Astro.locals.clientFlags === undefined ? undefined : JSON.stringify(Astro.locals.clientFlags));
const clientFlags = (() => {
  try {
    const parsed: unknown = JSON.parse(flagsJson ?? "{}");
    return typeof parsed === "object" && parsed !== null
      ? (parsed as Record<string, unknown>)
      : {};
  } catch {
    return {};
  }
})();
const pwaEnabled = clientFlags.pwa === true;
const pwa = pwaEnabled ? await pwaBuild() : null;
---

<!doctype html>
<html
  lang={locale}
  data-auth-state={authState}
  data-visitor={visitor}
  data-server-locale={serverLocale}
  data-locale-source={localeSource}
  data-client-flags={flagsJson}
  data-scheme={colourScheme}
  data-plugins-origin={configuredPluginOrigin()}
  data-pwa-version={pwa?.version}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:," />
    {pwaEnabled ? <link rel="manifest" href="/manifest.webmanifest" /> : null}
    {pwaEnabled ? <link rel="apple-touch-icon" href="/pwa/icon-180.png" /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robots === "noindex" ? <meta name="robots" content="noindex" /> : null}
    <title>{title}</title>
  </head>
  <body>
    <div set:html={body} />
    <slot />
    <!-- The theme layer must follow the app's emitted default stylesheet. -->
    <link rel="stylesheet" href="/theme-css" />
    <script>import "../islands.ts";</script>
    <script>import "../plugins/bridge.ts";</script>
    <script>import "../visits.ts";</script>
    {pwaEnabled ? <script>import "../pwa/register.ts";</script> : null}
    {pwaEnabled ? <script>import "../offline/client.ts";</script> : null}
    <script>import "../realtime/client.ts";</script>
    <script>import "../read-tracking/client.ts";</script>
  </body>
</html>
