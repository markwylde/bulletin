---
import { localiseSeoMetadata, type SeoMetadata } from "@bulletin/domain/seo";
import "../theme/default.css";
import { configuredPluginOrigin } from "../plugins/config.ts";
import { pwaBuild } from "../pwa/build.ts";

interface Props {
  readonly title: string;
  readonly locale: string;
  readonly body: string;
  /** Set on pages that require a member, so the auth helpers can detect the state. */
  readonly authState?: "authenticated";
  /** Chooses the overlay (members) or the beacon (guests) for visit recording. */
  readonly visitor: "member" | "guest";
  /** The member's locale source, for the client locale/board bootstrap. */
  readonly serverLocale?: string;
  readonly localeSource?: "member" | "guest";
  /** Legacy explicit noindex; public routes pass the full `seo` view model instead. */
  readonly robots?: "noindex";
  /** Client-visible flags as JSON; only affects the island provider, never shared content. */
  readonly clientFlagsJson?: string | undefined;
  /** The member's saved scheme or the guest's `bp` choice. */
  readonly colourScheme?: "light" | "dark" | "system";
  /** Page metadata rendered into the default theme's head (change `seo-feeds`). */
  readonly seo?: SeoMetadata;
}

const {
  title,
  locale,
  body,
  authState,
  visitor,
  serverLocale,
  localeSource,
  robots,
  clientFlagsJson,
  colourScheme = "system",
  seo: routeSeo,
} = Astro.props;
// Canonical and hreflang follow the locale this response was rendered in (ADR 0013).
const seo =
  routeSeo === undefined
    ? undefined
    : localiseSeoMetadata(routeSeo, {
        locale,
        explicitLocale: Astro.locals.localeFromQuery === true,
        boardDefaultLocale: Astro.locals.board?.defaultLocale ?? null,
      });
const origin = Astro.url.origin;
const canonical = seo === undefined ? null : new URL(seo.canonicalPath, origin).toString();
const jsonLd =
  seo?.jsonLd === null || seo?.jsonLd === undefined
    ? null
    : JSON.stringify(seo.jsonLd).replaceAll("<", "\\u003c");
const robotsDirective = seo?.robots ?? robots ?? "noindex";
const flagsJson =
  clientFlagsJson ??
  (Astro.locals.clientFlags === undefined ? undefined : JSON.stringify(Astro.locals.clientFlags));
const clientFlags = (() => {
  try {
    const parsed: unknown = JSON.parse(flagsJson ?? "{}");
    return typeof parsed === "object" && parsed !== null
      ? (parsed as Record<string, unknown>)
      : {};
  } catch {
    return {};
  }
})();
const pwaEnabled = clientFlags.pwa === true;
const pwa = pwaEnabled ? await pwaBuild() : null;
const memberId = Astro.locals.session?.memberId ?? "";
---

<!doctype html>
<html
  lang={locale}
  data-auth-state={authState}
  data-visitor={visitor}
  data-member-id={memberId}
  data-server-locale={serverLocale}
  data-locale-source={localeSource}
  data-client-flags={flagsJson}
  data-scheme={colourScheme}
  data-plugins-origin={configuredPluginOrigin()}
  data-pwa-version={pwa?.version}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:," />
    {pwaEnabled ? <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" /> : null}
    {pwaEnabled ? <link rel="apple-touch-icon" href="/pwa/icon-180.png" /> : null}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robotsDirective} />
    {seo === undefined ? null : <meta name="description" content={seo.description} />}
    {canonical === null ? null : <link rel="canonical" href={canonical} />}
    {seo?.alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.path, origin).toString()}
      />
    ))}
    <title>{seo?.title ?? title}</title>
    {seo === undefined || canonical === null ? null : (
      <>
        <meta property="og:type" content={seo.type} />
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:description" content={seo.description} />
      </>
    )}
    {jsonLd === null ? null : (
      <script
        type="application/ld+json"
        nonce={Astro.locals.cspNonce}
        set:html={jsonLd}
      />
    )}
  </head>
  <body>
    <div set:html={body} />
    <slot />
    <!-- The theme layer must follow the app's emitted default stylesheet. -->
    <link rel="stylesheet" href="/theme-css" />
    <script>import "../islands.ts";</script>
    <script>import "../plugins/bridge.ts";</script>
    <script>import "../visits.ts";</script>
    {pwaEnabled ? <script>import "../pwa/register.ts";</script> : null}
    <script>import "../offline/client.ts";</script>
    <script>import "../realtime/client.ts";</script>
    <script>import "../read-tracking/client.ts";</script>
  </body>
</html>
