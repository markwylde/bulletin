{{ header }}
<main id="main" class="bl-main" data-topic-page data-topic-id="{{ topicId }}" data-forum-id="{{ forumId }}" data-overlay-ctx="topic:{{ topicId }}" data-label-unapproved="{% t "post.unapproved" %}"{% if readMarkerAt %} data-overlay-last-post-at="{{ readMarkerAt }}" data-overlay-last-post-id="{{ readMarkerPostId }}"{% endif %}
  data-report-labels
  data-label-report-title="{% t "report.dialog.title" %}"
  data-label-report-intro="{% t "report.dialog.intro" %}"
  data-label-report-reason="{% t "report.dialog.reason" %}"
  data-label-report-reason-spam="{% t "report.reason.spam" %}"
  data-label-report-reason-abuse="{% t "report.reason.abuse" %}"
  data-label-report-reason-harassment="{% t "report.reason.harassment" %}"
  data-label-report-reason-off-topic="{% t "report.reason.offTopic" %}"
  data-label-report-reason-other="{% t "report.reason.other" %}"
  data-label-report-comment="{% t "report.dialog.comment" %}"
  data-label-report-submit="{% t "report.dialog.submit" %}"
  data-label-report-cancel="{% t "report.dialog.cancel" %}"
  data-label-report-sent="{% t "report.dialog.sent" %}"
  data-label-report-failed="{% t "report.dialog.failed" %}"
  data-label-report-already="{% t "report.dialog.already" %}">
  {{ breadcrumbs }}
  <header class="bl-page__header">
    <p class="bl-muted">
      <a href="/forum/{{ forumId }}" data-topic-forum-link>{% t "topic.backToForum" %}</a>
    </p>
    <h1 class="bl-page__title" data-topic-title>
      {% if prefix %}<span class="bl-prefix-tag" style="--bl-prefix: {{ prefix.colour }}">{{ prefix.label }}</span>{% endif %}
      {{ title }}
    </h1>
    <p class="bl-topic__meta">
      {% if pinned %}<span class="bl-badge" data-topic-pinned>{% t "topic.pinned" %}</span>{% endif %}
      {% if locked %}<span class="bl-badge" data-topic-locked>{% t "topic.locked" %}</span>{% endif %}
      <span data-topic-replies="{{ topicId }}">{{ replyCount }}</span>
      {{ viewsSlot }}
    </p>
    {% if isModerator %}
      <p class="bl-note" data-topic-mod-note>{% t "topic.modNote" %} <a href="/moderation/queue" data-mod-queue-link>{% t "moderation.queue.open" %}</a> · <a href="/moderation/reports" data-reports-link>{% t "moderation.reports.open" %}</a></p>
    {% endif %}
    {% if flags.follows %}
    <span class="bl-follow" data-overlay-member-only hidden data-follow-context="topic:{{ topicId }}">
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="follow">{% t "follow.followTopic" %}</button>
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="unfollow" hidden>{% t "follow.unfollowTopic" %}</button>
      <span class="bl-error-text" data-follow-error hidden>{% t "follow.failed" %}</span>
    </span>
    {% endif %}
    {% if canHardDeleteTopic %}
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-topic-action="hard" data-topic-id="{{ topicId }}" data-confirm="{% t "topic.confirmDelete" %}">{% t "topic.delete" %}</button>
    {% endif %}
  </header>

  {% if topicTools.pin or topicTools.lock or topicTools.move or topicTools.merge or topicTools.split or topicTools.multimod and flags.multimod %}
    <details class="bl-card" data-topic-tools
      data-label-failed="{% t "moderation.tools.failed" %}"
      data-label-saved="{% t "moderation.tools.saved" %}"
      data-label-nothing-selected="{% t "moderation.bulk.nothingSelected" %}">
      <summary class="bl-card__title">{% t "moderation.tools.title" %}</summary>
      <div class="bl-actions">
        {% if topicTools.pin %}<button class="bl-button bl-button--small" type="button" data-topic-tool="pin" data-topic-id="{{ topicId }}">{% t "topic.pin" %}</button>{% endif %}
        {% if topicTools.unpin %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-topic-tool="unpin" data-topic-id="{{ topicId }}">{% t "topic.unpin" %}</button>{% endif %}
        {% if topicTools.lock %}<button class="bl-button bl-button--small" type="button" data-topic-tool="lock" data-topic-id="{{ topicId }}">{% t "topic.lock" %}</button>{% endif %}
        {% if topicTools.unlock %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-topic-tool="unlock" data-topic-id="{{ topicId }}">{% t "topic.unlock" %}</button>{% endif %}
      </div>

      {% if topicTools.move %}
        <form class="bl-form" data-topic-move-form data-topic-id="{{ topicId }}">
          <label class="bl-label" for="topic-move-forum">{% t "moderation.tools.moveTo" %}</label>
          <select class="bl-input" id="topic-move-forum" name="forumId" required>
            <option value="">{% t "moderation.tools.chooseForum" %}</option>
            {% for target in moveTargets %}<option value="{{ target.id }}">{{ target.title }}</option>{% endfor %}
          </select>
          <label class="bl-label" for="topic-move-stub">{% t "moderation.tools.stubDays" %}</label>
          <input class="bl-input" id="topic-move-stub" name="stubDays" type="number" min="0" max="365" value="0" />
          <button class="bl-button" type="submit" data-topic-move-submit>{% t "moderation.tools.move" %}</button>
        </form>
      {% endif %}

      {% if topicTools.merge and mergeTargets.size > 0 %}
        <form class="bl-form" data-topic-merge-form data-topic-id="{{ topicId }}">
          <label class="bl-label" for="topic-merge-target">{% t "moderation.tools.mergeInto" %}</label>
          <select class="bl-input" id="topic-merge-target" name="sourceTopicId" required>
            <option value="">{% t "moderation.tools.chooseTopic" %}</option>
            {% for target in mergeTargets %}<option value="{{ target.id }}">{{ target.title }}</option>{% endfor %}
          </select>
          <label class="bl-label" for="topic-merge-title">{% t "moderation.tools.mergedTitle" %}</label>
          <input class="bl-input" id="topic-merge-title" name="title" type="text" maxlength="150" placeholder="{% t "moderation.tools.keepTitle" %}" />
          <label class="bl-label" for="topic-merge-stub">{% t "moderation.tools.stubDays" %}</label>
          <input class="bl-input" id="topic-merge-stub" name="stubDays" type="number" min="0" max="365" value="0" />
          <button class="bl-button" type="submit" data-topic-merge-submit>{% t "moderation.tools.merge" %}</button>
        </form>
      {% endif %}

      {% if topicTools.split %}
        <form class="bl-form" data-topic-split-form data-topic-id="{{ topicId }}">
          <p class="bl-muted">{% t "moderation.tools.splitHelp" %}</p>
          <label class="bl-label" for="topic-split-title">{% t "moderation.tools.splitTitle" %}</label>
          <input class="bl-input" id="topic-split-title" name="title" type="text" minlength="3" maxlength="150" required />
          <label class="bl-label" for="topic-split-forum">{% t "moderation.tools.splitForum" %}</label>
          <select class="bl-input" id="topic-split-forum" name="forumId" required>
            {% for target in moveTargets %}<option value="{{ target.id }}"{% if target.id == forumId %} selected{% endif %}>{{ target.title }}</option>{% endfor %}
          </select>
          <button class="bl-button" type="submit" data-topic-split-submit>{% t "moderation.tools.split" %}</button>
        </form>
      {% endif %}

      {% if flags.multimod and topicTools.multimod and multimodActions.size > 0 %}
        <form class="bl-form" data-topic-multimod-form data-topic-id="{{ topicId }}">
          <label class="bl-label" for="topic-multimod-action">{% t "moderation.tools.multimod" %}</label>
          <select class="bl-input" id="topic-multimod-action" name="actionId" required>
            {% for action in multimodActions %}<option value="{{ action.id }}">{{ action.name }}</option>{% endfor %}
          </select>
          <button class="bl-button" type="submit" data-topic-multimod-submit>{% t "moderation.tools.apply" %}</button>
        </form>
      {% endif %}
      <p class="bl-error-text" data-topic-tools-error hidden></p>
    </details>
  {% endif %}

  {% if flags.realtime %}
  <button class="bl-button bl-new-replies" type="button" data-new-replies
    data-label-one="{% t "realtime.newReplyOne" %}"
    data-label-other="{% t "realtime.newReplyOther" %}" hidden></button>
  {% endif %}

  {% if flags.polls and pollSlot %}{{ pollSlot }}{% endif %}

  {% if posts.size > 0 %}
    <ol class="bl-post-list" data-post-list>
      {% for post in posts %}
        <bl-post-block data-post="{{ post.id }}"></bl-post-block>
      {% endfor %}
    </ol>
    {% if pagination.pageCount > 1 %}
      <nav class="bl-pagination" data-post-pagination aria-label="{% t "topic.pagination" %}">
        {% if pagination.previousHref %}
          <a class="bl-pagination__link" href="{{ pagination.previousHref }}" rel="prev" data-page-prev>{% t "topic.previousPage" %}</a>
        {% endif %}
        <span class="bl-muted" data-page-status>{% t "topic.pageOf" page: pagination.page, pages: pagination.pageCount %}</span>
        {% if pagination.nextHref %}
          <a class="bl-pagination__link" href="{{ pagination.nextHref }}" rel="next" data-page-next>{% t "topic.nextPage" %}</a>
        {% endif %}
      </nav>
    {% endif %}
  {% if topicTools.deletePosts or topicTools.restorePosts or topicTools.approvePosts %}
    <div class="bl-card" data-bulk-posts data-topic-id="{{ topicId }}"
      data-label-failed="{% t "moderation.bulk.failed" %}"
      data-label-saved="{% t "moderation.bulk.saved" %}"
      data-label-nothing-selected="{% t "moderation.bulk.nothingSelected" %}">
      <h2 class="bl-card__title">{% t "moderation.bulk.postsTitle" %}</h2>
      <div class="bl-actions">
        {% if topicTools.deletePosts %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-post-action="soft_delete">{% t "moderation.bulk.softDelete" %}</button>{% endif %}
        {% if topicTools.restorePosts %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-post-action="restore">{% t "moderation.bulk.restore" %}</button>{% endif %}
        {% if topicTools.approvePosts %}<button class="bl-button bl-button--small" type="button" data-bulk-post-action="approve">{% t "moderation.bulk.approve" %}</button>{% endif %}
      </div>
      <p class="bl-error-text" data-bulk-posts-error hidden></p>
    </div>
  {% endif %}

  {% else %}
    <div data-topic-empty>{{ emptyState }}</div>
  {% endif %}

  {% if canReply and editor %}
    <section class="bl-card" data-reply-section>
      <button class="bl-button" type="button" data-reply-toggle>{% t "post.reply" %}</button>
      <form class="bl-topic-form" data-reply-form data-topic-id="{{ topicId }}" hidden
        data-label-blocked-word="{% t "topic.blockedWord" %}"
        data-label-too-many-links="{% t "topic.tooManyLinks" %}">
        {% island "Editor" editor %}
        <button class="bl-button" type="submit" data-reply-submit>{% t "post.submitReply" %}</button>
        <p class="bl-error-text" data-form-error hidden>{% t "topic.postFailed" %}</p>
      </form>
    </section>
  {% endif %}
</main>
{{ footer }}
