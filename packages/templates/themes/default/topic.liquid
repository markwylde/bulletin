{{ header }}
<main id="main" class="bl-main" data-topic-page data-topic-id="{{ topicId }}" data-forum-id="{{ forumId }}" data-overlay-ctx="topic:{{ topicId }}" data-label-unapproved="{% t "post.unapproved" %}"{% if readMarkerAt %} data-overlay-last-post-at="{{ readMarkerAt }}" data-overlay-last-post-id="{{ readMarkerPostId }}"{% endif %}
  data-report-labels
  data-label-report-title="{% t "report.dialog.title" %}"
  data-label-report-intro="{% t "report.dialog.intro" %}"
  data-label-report-reason="{% t "report.dialog.reason" %}"
  data-label-report-reason-spam="{% t "report.reason.spam" %}"
  data-label-report-reason-abuse="{% t "report.reason.abuse" %}"
  data-label-report-reason-harassment="{% t "report.reason.harassment" %}"
  data-label-report-reason-off-topic="{% t "report.reason.offTopic" %}"
  data-label-report-reason-other="{% t "report.reason.other" %}"
  data-label-report-comment="{% t "report.dialog.comment" %}"
  data-label-report-submit="{% t "report.dialog.submit" %}"
  data-label-report-cancel="{% t "report.dialog.cancel" %}"
  data-label-report-sent="{% t "report.dialog.sent" %}"
  data-label-report-failed="{% t "report.dialog.failed" %}"
  data-label-report-already="{% t "report.dialog.already" %}">
  {{ breadcrumbs }}
  <header class="bl-page__header">
    <p class="bl-muted">
      <a href="/forum/{{ forumId }}" data-topic-forum-link>{% t "topic.backToForum" %}</a>
    </p>
    <h1 class="bl-page__title" data-topic-title>
      {% if prefix %}<span class="bl-prefix-tag" style="--bl-prefix: {{ prefix.colour }}">{{ prefix.label }}</span>{% endif %}
      {{ title }}
    </h1>
    <p class="bl-topic__meta">
      {% if pinned %}<span class="bl-badge" data-topic-pinned>{% t "topic.pinned" %}</span>{% endif %}
      {% if locked %}<span class="bl-badge" data-topic-locked>{% t "topic.locked" %}</span>{% endif %}
      <span data-topic-replies="{{ topicId }}">{{ replyCount }}</span>
      {{ viewsSlot }}
    </p>
    {% if isModerator %}
      <p class="bl-note" data-topic-mod-note>{% t "topic.modNote" %} <a href="/moderation/queue" data-mod-queue-link>{% t "moderation.queue.open" %}</a> · <a href="/moderation/reports" data-reports-link>{% t "moderation.reports.open" %}</a></p>
    {% endif %}
    {% if flags.follows %}
    <span class="bl-follow" data-overlay-member-only hidden data-follow-context="topic:{{ topicId }}">
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="follow">{% t "follow.followTopic" %}</button>
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="unfollow" hidden>{% t "follow.unfollowTopic" %}</button>
      <span class="bl-error-text" data-follow-error hidden>{% t "follow.failed" %}</span>
    </span>
    {% endif %}
    {% if canHardDeleteTopic %}
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-topic-action="hard" data-topic-id="{{ topicId }}" data-confirm="{% t "topic.confirmDelete" %}">{% t "topic.delete" %}</button>
    {% endif %}
  </header>

  {% if flags.realtime %}
  <button class="bl-button bl-new-replies" type="button" data-new-replies
    data-label-one="{% t "realtime.newReplyOne" %}"
    data-label-other="{% t "realtime.newReplyOther" %}" hidden></button>
  {% endif %}

  {% if flags.polls and pollSlot %}{{ pollSlot }}{% endif %}

  {% if posts.size > 0 %}
    <ol class="bl-post-list" data-post-list>
      {% for post in posts %}
        <bl-post-block data-post="{{ post.id }}"></bl-post-block>
      {% endfor %}
    </ol>
    {% if pagination.pageCount > 1 %}
      <nav class="bl-pagination" data-post-pagination aria-label="{% t "topic.pagination" %}">
        {% if pagination.previousHref %}
          <a class="bl-pagination__link" href="{{ pagination.previousHref }}" rel="prev" data-page-prev>{% t "topic.previousPage" %}</a>
        {% endif %}
        <span class="bl-muted" data-page-status>{% t "topic.pageOf" page: pagination.page, pages: pagination.pageCount %}</span>
        {% if pagination.nextHref %}
          <a class="bl-pagination__link" href="{{ pagination.nextHref }}" rel="next" data-page-next>{% t "topic.nextPage" %}</a>
        {% endif %}
      </nav>
    {% endif %}
  {% else %}
    <div data-topic-empty>{{ emptyState }}</div>
  {% endif %}

  {% if canReply and editor %}
    <section class="bl-card" data-reply-section>
      <button class="bl-button" type="button" data-reply-toggle>{% t "post.reply" %}</button>
      <form class="bl-topic-form" data-reply-form data-topic-id="{{ topicId }}" hidden>
        {% island "Editor" editor %}
        <button class="bl-button" type="submit" data-reply-submit>{% t "post.submitReply" %}</button>
        <p class="bl-error-text" data-form-error hidden>{% t "topic.postFailed" %}</p>
      </form>
    </section>
  {% endif %}
</main>
{{ footer }}
