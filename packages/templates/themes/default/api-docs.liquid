{{ header }}
<main id="main" class="bl-main" data-api-docs-page>
  {{ breadcrumbs }}
  <header class="bl-page-header">
    <div class="bl-page-header__text">
      <h1 class="bl-page__title">{% t "api.docs.title" %}</h1>
      <p class="bl-page-header__meta">{% t "api.docs.intro" %}</p>
    </div>
    <div class="bl-page-header__actions">
      <a class="bl-button bl-button--quiet bl-button--small" href="{{ openApiUrl }}" data-api-docs-raw>{% t "api.docs.raw" %}</a>
    </div>
  </header>
  <section class="bl-api-docs" data-api-docs>
    {% island "ApiDocs" apiDocs %}
    <p class="bl-muted" id="api-reference-status" data-api-reference-status data-error="{% t "api.docs.error" %}" role="status">{% t "api.docs.loading" %}</p>
    <p class="bl-muted">{% t "api.docs.noScript" %}</p>
  </section>
</main>
{{ footer }}
