{{ header }}
<main id="main" class="bl-main" data-forum-page data-forum-id="{{ forumId }}" data-label-unapproved="{% t "post.unapproved" %}"{% if locked %}{% else %} data-overlay-ctx="forum:{{ forumId }}" data-overlay-forum="{{ forumId }}"{% endif %}>
  {{ breadcrumbs }}
  <header class="bl-page__header">
    <h1 class="bl-page__title" data-forum-title>{{ title }}</h1>
    {% if description.size > 0 %}
      <p class="bl-muted" data-forum-description>{{ description }}</p>
    {% endif %}
    <p class="bl-muted">
      <span data-topic-count="{{ forumId }}">{{ topicCount }}</span>
      <span data-post-count="{{ forumId }}">{{ postCount }}</span>
      <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ forumId }}">—</span>
    </p>
    <button class="bl-button bl-button--quiet bl-button--small" type="button" data-mark-forum-read="{{ forumId }}" data-overlay-member-only hidden>{% t "read.markForum" %}</button>
    {% if flags.follows %}
    <span class="bl-follow" data-overlay-member-only hidden data-follow-context="forum:{{ forumId }}">
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="follow">{% t "follow.followForum" %}</button>
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-follow-action="unfollow" hidden>{% t "follow.unfollowForum" %}</button>
      <span class="bl-error-text" data-follow-error hidden>{% t "follow.failed" %}</span>
    </span>
    {% endif %}
  </header>

  {% if isModerator %}
    <p class="bl-note" data-forum-mod-note>{% t "forum.modNote" %} <a href="/moderation/queue" data-mod-queue-link>{% t "moderation.queue.open" %}</a> · <a href="/moderation/reports" data-reports-link>{% t "moderation.reports.open" %}</a></p>
  {% endif %}

  {% if locked %}
    <section class="bl-card bl-lock" data-forum-locked>
      <h2 class="bl-card__title">{% t "forum.locked.title" %}</h2>
      <p class="bl-muted">{% t "forum.locked.body" %}</p>
      <form class="bl-form" data-forum-unlock data-forum-id="{{ forumId }}">
        <label class="bl-label" for="forum-password">{% t "forum.locked.password" %}</label>
        <input class="bl-input" id="forum-password" name="password" type="password" autocomplete="current-password" required />
        <button class="bl-button" type="submit" data-forum-unlock-submit>{% t "forum.locked.submit" %}</button>
        <p class="bl-error-text" data-forum-unlock-error hidden>{% t "forum.locked.wrong" %}</p>
      </form>
    </section>
  {% else %}
    <div data-forum-content>
      {% if rules %}
        <details class="bl-card bl-rules" data-rules data-forum-id="{{ forumId }}" open>
          <summary class="bl-rules__summary">{% t "forum.rules.title" %}</summary>
          <p class="bl-rules__body">{{ rules }}</p>
        </details>
      {% endif %}

      {% if flags.announcements and announcements.size > 0 %}
        <section class="bl-announcements" data-announcements aria-label="{% t "forum.announcements" %}">
          {% for announcement in announcements %}
            <article class="bl-card bl-announcement" data-announcement="{{ announcement.id }}">
              <h2 class="bl-announcement__title">{{ announcement.title }}</h2>
              <p class="bl-announcement__body">{{ announcement.body }}</p>
              {% if announcement.dismissible %}
                <button type="button" class="bl-button bl-button--quiet bl-button--small" data-announcement-dismiss="{{ announcement.id }}" data-overlay-member-only hidden>{% t "announcement.dismiss" %}</button>
              {% endif %}
            </article>
          {% endfor %}
        </section>
      {% endif %}

      {% if isCategory %}
        {% if children.size > 0 %}
          <ul class="bl-forum-list" data-forum-children>
            {% for child in children %}
              <li class="bl-forum-list__item" data-overlay-forum="{{ child.id }}">
                <a class="bl-forum-list__link" href="{{ child.href }}" data-forum-child="{{ child.id }}">{{ child.title }}</a>
                <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ child.id }}">—</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          {{ emptyState }}
        {% endif %}
      {% else %}
        {% if prefixes.size > 0 %}
          <nav class="bl-prefix-filter" data-prefix-filter aria-label="{% t "forum.prefixFilter" %}">
            <a class="bl-prefix{% if activePrefix == null %} is-active{% endif %}" href="{{ href }}" data-prefix-all>{% t "forum.prefixAll" %}</a>
            {% for prefix in prefixes %}
              <a class="bl-prefix{% if activePrefix == prefix.key %} is-active{% endif %}" style="--bl-prefix: {{ prefix.colour }}" href="{{ href }}?prefix={{ prefix.key }}" data-prefix-key="{{ prefix.key }}">{{ prefix.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}
        {% if canStart and editor %}
          <details class="bl-card" data-new-topic>
            <summary class="bl-card__title">{% t "topic.new" %}</summary>
            <form class="bl-topic-form" data-new-topic-form data-forum-id="{{ forumId }}"
              data-label-blocked-word="{% t "topic.blockedWord" %}"
              data-label-too-many-links="{% t "topic.tooManyLinks" %}"
              data-label-acknowledgement-required="{% t "topic.acknowledgementRequired" %}"
              data-label-posting-suspended="{% t "topic.postingSuspendedUntil" date: "__DATE__" %}"
              data-label-review-warnings="{% t "warnings.title" %}">
              <label class="bl-label" for="new-topic-title">{% t "topic.title" %}</label>
              <input class="bl-input" id="new-topic-title" name="title" type="text" minlength="3" maxlength="150" required />
              {% if prefixes.size > 0 %}
                <label class="bl-label" for="new-topic-prefix">{% t "topic.prefix" %}</label>
                <select class="bl-input" id="new-topic-prefix" name="prefixId"{% if prefixRequired %} required{% endif %}>
                  <option value="">{% t "topic.choosePrefix" %}</option>
                  {% for prefix in prefixes %}
                    <option value="{{ prefix.id }}">{{ prefix.label }}</option>
                  {% endfor %}
                </select>
              {% endif %}
              {% if flags.polls %}
              <fieldset class="bl-poll-builder" data-poll-builder
                data-label-question="{% t "poll.question" %}"
                data-label-choice="{% t "poll.choice" %}"
                data-label-multiple="{% t "poll.multiple" %}"
                data-label-add-choice="{% t "poll.addChoice" %}"
                data-label-remove="{% t "poll.remove" %}">
                <legend>{% t "poll.add" %}</legend>
                <div data-poll-questions></div>
                <button class="bl-button bl-button--quiet bl-button--small" type="button" data-poll-add-question>{% t "poll.addQuestion" %}</button>
                <label class="bl-label" for="poll-closes-at">{% t "poll.closesAt" %}</label>
                <input class="bl-input" id="poll-closes-at" name="pollClosesAt" type="datetime-local" />
                <label class="bl-check"><input type="checkbox" name="pollResultsVisible" /> {% t "poll.resultsVisible" %}</label>
              </fieldset>
              {% endif %}
              {% island "Editor" editor %}
              <button class="bl-button" type="submit" data-new-topic-submit>{% t "topic.create" %}</button>
              <p class="bl-error-text" data-form-error hidden>{% t "topic.postFailed" %}</p>
            </form>
          </details>
        {% endif %}

        {% if bulkTopics.pin or bulkTopics.lock or bulkTopics.move or bulkTopics.softDelete or bulkTopics.restore or bulkTopics.approve %}
          <div class="bl-card" data-bulk-topics data-forum-id="{{ forumId }}"
            data-label-failed="{% t "moderation.bulk.failed" %}"
            data-label-saved="{% t "moderation.bulk.saved" %}"
            data-label-nothing-selected="{% t "moderation.bulk.nothingSelected" %}">
            <h2 class="bl-card__title">{% t "moderation.bulk.topicsTitle" %}</h2>
            <div class="bl-actions">
              {% if bulkTopics.pin %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="pin">{% t "topic.pin" %}</button>{% endif %}
              {% if bulkTopics.unpin %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="unpin">{% t "topic.unpin" %}</button>{% endif %}
              {% if bulkTopics.lock %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="lock">{% t "topic.lock" %}</button>{% endif %}
              {% if bulkTopics.unlock %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="unlock">{% t "topic.unlock" %}</button>{% endif %}
              {% if bulkTopics.softDelete %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="soft_delete">{% t "moderation.bulk.softDelete" %}</button>{% endif %}
              {% if bulkTopics.restore %}<button class="bl-button bl-button--quiet bl-button--small" type="button" data-bulk-topic-action="restore">{% t "moderation.bulk.restore" %}</button>{% endif %}
              {% if bulkTopics.approve %}<button class="bl-button bl-button--small" type="button" data-bulk-topic-action="approve">{% t "moderation.bulk.approve" %}</button>{% endif %}
            </div>
            {% if bulkTopics.move %}
              <div class="bl-form">
                <label class="bl-label" for="bulk-topic-forum">{% t "moderation.bulk.moveTo" %}</label>
                <select class="bl-input" id="bulk-topic-forum" data-bulk-topic-forum>
                  <option value="">{% t "moderation.tools.chooseForum" %}</option>
                  {% for target in moveTargets %}<option value="{{ target.id }}">{{ target.title }}</option>{% endfor %}
                </select>
                <label class="bl-label" for="bulk-topic-stub">{% t "moderation.tools.stubDays" %}</label>
                <input class="bl-input" id="bulk-topic-stub" data-bulk-topic-stub type="number" min="0" max="365" value="0" />
                <button class="bl-button" type="button" data-bulk-topic-action="move">{% t "moderation.bulk.move" %}</button>
              </div>
            {% endif %}
            <p class="bl-error-text" data-bulk-topics-error hidden></p>
          </div>
        {% endif %}

        {% if topics.size > 0 %}
          <ol class="bl-topic-list" data-topic-list data-topic-page="{{ pagination.page }}">
            {% for topic in topics %}
              <li class="bl-topic-list__item{% if topic.moved %} is-moved{% endif %}" data-topic-row="{{ topic.id }}">
                <div class="bl-topic-row__main">
                  {% if topic.bulk %}<input type="checkbox" value="{{ topic.id }}" data-bulk-topic-check="{{ topic.id }}" aria-label="{% t "moderation.bulk.select" %}" />{% endif %}
                  {% if topic.prefix %}
                    <span class="bl-prefix-tag" style="--bl-prefix: {{ topic.prefix.colour }}" data-topic-prefix="{{ topic.prefix.key }}">{{ topic.prefix.label }}</span>
                  {% endif %}
                  <a class="bl-topic-list__title" href="{{ topic.href }}" data-topic-link="{{ topic.id }}">{{ topic.title }}</a>
                  {% if topic.pinned %}<span class="bl-badge" data-topic-pinned>{% t "topic.pinned" %}</span>{% endif %}
                  {% if topic.locked %}<span class="bl-badge" data-topic-locked>{% t "topic.locked" %}</span>{% endif %}
                  {% if topic.moved %}<span class="bl-badge" data-topic-moved>{% t "topic.moved" %}</span>{% endif %}
                </div>
                <div class="bl-topic-row__stats">
                  <span data-topic-replies="{{ topic.id }}">{{ topic.replies }}</span>
                  <span data-topic-views="{{ topic.id }}">{{ topic.views }}</span>
                  {% if topic.lastPost %}
                    <span class="bl-muted" data-topic-last-post="{{ topic.id }}">
                      {% if topic.lastPost.memberName %}
                        {% t "index.lastPostBy" date: topic.lastPost.date, member: topic.lastPost.memberName %}
                      {% else %}
                        {% t "index.lastPost" date: topic.lastPost.date %}
                      {% endif %}
                    </span>
                  {% endif %}
                  <span class="bl-overlay-slot" data-overlay-unread data-overlay-context="topic:{{ topic.id }}">—</span>
                  <a class="bl-muted" data-overlay-first-unread data-overlay-context="topic:{{ topic.id }}" href="{{ topic.href }}" hidden>{% t "topic.firstUnread" %}</a>
                </div>
              </li>
            {% endfor %}
          </ol>
          {% if pagination.pageCount > 1 %}
            <nav class="bl-pagination" data-topic-pagination aria-label="{% t "topic.pagination" %}">
              {% if pagination.previousHref %}
                <a class="bl-pagination__link" href="{{ pagination.previousHref }}" rel="prev" data-page-prev>{% t "topic.previousPage" %}</a>
              {% endif %}
              <span class="bl-muted" data-page-status>{% t "topic.pageOf" page: pagination.page, pages: pagination.pageCount %}</span>
              {% if pagination.nextHref %}
                <a class="bl-pagination__link" href="{{ pagination.nextHref }}" rel="next" data-page-next>{% t "topic.nextPage" %}</a>
              {% endif %}
            </nav>
          {% endif %}
        {% else %}
          <div data-topic-list-empty>{{ emptyState }}</div>
        {% endif %}
      {% endif %}

      {% unless isCategory %}
        {% if children.size > 0 %}
          <section class="bl-card" data-subforums-block>
            <h2 class="bl-card__title">{% t "index.subforums" %}</h2>
            <ul class="bl-forum-list" data-forum-children>
              {% for child in children %}
                <li class="bl-forum-list__item" data-overlay-forum="{{ child.id }}">
                  <a class="bl-forum-list__link" href="{{ child.href }}" data-forum-child="{{ child.id }}">{{ child.title }}</a>
                  <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ child.id }}">—</span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endunless %}

      {% if moderators.size > 0 %}
        <section class="bl-card" data-moderators aria-label="{% t "forum.moderators" %}">
          <h2 class="bl-card__title">{% t "forum.moderators" %}</h2>
          <ul class="bl-moderator-list">
            {% for moderator in moderators %}
              <li data-moderator-kind="{{ moderator.kind }}" data-moderator="{{ moderator.id }}">{{ moderator.name }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  {% endif %}
</main>
{{ footer }}
