{{ header }}
<main id="main" class="bl-main" data-conversation-page data-conversation-id="{{ conversationId }}" data-archived="{{ archived }}" data-starter="{{ isStarter }}"
  data-report-labels
  data-label-report-title="{% t "report.dialog.title" %}"
  data-label-report-intro="{% t "report.dialog.intro" %}"
  data-label-report-reason="{% t "report.dialog.reason" %}"
  data-label-report-reason-spam="{% t "report.reason.spam" %}"
  data-label-report-reason-abuse="{% t "report.reason.abuse" %}"
  data-label-report-reason-harassment="{% t "report.reason.harassment" %}"
  data-label-report-reason-off-topic="{% t "report.reason.offTopic" %}"
  data-label-report-reason-other="{% t "report.reason.other" %}"
  data-label-report-comment="{% t "report.dialog.comment" %}"
  data-label-report-submit="{% t "report.dialog.submit" %}"
  data-label-report-cancel="{% t "report.dialog.cancel" %}"
  data-label-report-sent="{% t "report.dialog.sent" %}"
  data-label-report-failed="{% t "report.dialog.failed" %}"
  data-label-report-already="{% t "report.dialog.already" %}">
  {{ breadcrumbs }}
  <header class="bl-page-header bl-thread-header">
    <div class="bl-page-header__text">
    <h1 class="bl-page__title" data-conversation-title>{{ title }}</h1>
    <p class="bl-page-header__meta" data-conversation-participants><span>
      {%- for participant in participants -%}
        <span data-conversation-participant="{{ participant.id }}">{{ participant.name }}</span>{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    </span></p>
    </div>
    <div class="bl-page-header__actions">
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-conversation-archive="{% if archived %}false{% else %}true{% endif %}" data-label-archive="{% t "conversation.archive" %}" data-label-unarchive="{% t "conversation.unarchive" %}">{% if archived %}{% t "conversation.unarchive" %}{% else %}{% t "conversation.archive" %}{% endif %}</button>
    </div>
  </header>

  <div class="bl-thread">
  <div class="bl-thread__main">
  <ol class="bl-message-list" data-conversation-messages>
    {% for message in messages %}
      <li class="bl-message" data-conversation-message="{{ message.id }}">
        <header class="bl-message__header">
          {% if message.authorHref %}
            <a class="bl-message__author" href="{{ message.authorHref }}" data-conversation-author>{{ message.authorName }}</a>
          {% else %}
            <span class="bl-message__author" data-conversation-author>{{ message.authorName }}</span>
          {% endif %}
          <time class="bl-message__time" datetime="{{ message.iso }}">{{ message.time }}</time>
          <button class="bl-post__action bl-message__report" type="button" data-report-message="{{ message.id }}" data-overlay-member-only hidden><svg class="bl-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 17V3.5m0 0h9l-2 3.5 2 3.5H5" /></svg><span>{% t "report.reportMessage" %}</span></button>
        </header>
        <div class="bl-message__body">{{ message.body }}</div>
        {% if message.files %}{{ message.files }}{% endif %}
      </li>
    {% endfor %}
  </ol>

  {% if canReply and editor %}
    <section class="bl-card bl-thread__reply" data-reply-section>
      <h2 class="bl-card__title">{% t "conversation.reply" %}</h2>
      <form class="bl-form" data-conversation-reply-form data-conversation-id="{{ conversationId }}"
        data-label-pm-disabled="{% t "conversation.error.pmDisabled" %}"
        data-label-not-found="{% t "conversation.error.notFound" %}">
        {% island "Editor" editor %}
        <button class="bl-button" type="submit" data-reply-submit>{% t "conversation.submitReply" %}</button>
        <p class="bl-error-text" data-form-error hidden>{% t "conversation.replyFailed" %}</p>
      </form>
    </section>
  {% endif %}

  </div>
  <aside class="bl-thread__side">
  {% if isStarter %}
    <section class="bl-card" data-conversation-manage
      data-label-recipient-limit="{% t "conversation.error.recipientLimit" limit: "__limit__" %}"
      data-label-manage="{% t "conversation.error.manage" %}"
      data-label-recipient-unavailable="{% t "conversation.error.recipientUnavailable" %}"
      data-label-invite-blocked="{% t "conversation.error.inviteBlocked" %}"
      data-label-already-participant="{% t "conversation.error.alreadyParticipant" %}"
      data-label-pm-disabled="{% t "conversation.error.pmDisabled" %}"
      data-label-not-found="{% t "conversation.error.notFound" %}">
      <h2 class="bl-card__title">{% t "conversation.participants" %}</h2>
      <ul class="bl-participant-list">
        {% for participant in participants %}
          <li class="bl-participant" data-conversation-participant-row="{{ participant.id }}">
            <span>{{ participant.name }}</span>
            {% if participant.canRemove %}
              <button class="bl-button bl-button--quiet bl-button--small" type="button" data-conversation-remove="{{ participant.id }}" data-confirm="{% t "conversation.removeConfirm" %}">{% t "conversation.remove" %}</button>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      <div class="bl-recipient-picker" data-recipient-picker
        data-suggest-url="/api/members/suggest"
        data-label-empty="{% t "conversation.recipient.empty" %}"
        data-label-remove="{% t "conversation.recipient.remove" %}"
        data-label-selected="{% t "conversation.recipient.selected" %}">
        <label class="bl-label" for="invite-recipient">{% t "conversation.inviteLabel" %}</label>
        <input class="bl-input" id="invite-recipient" type="search" data-recipient-search placeholder="{% t "conversation.recipient.placeholder" %}" autocomplete="off" />
        <ul class="bl-recipient-results" data-recipient-results hidden></ul>
        <div class="bl-recipient-selected" data-recipient-selected></div>
        <p class="bl-muted" data-recipient-empty hidden></p>
      </div>
      <button class="bl-button" type="button" data-conversation-invite>{% t "conversation.invite" %}</button>
      <p class="bl-error-text" data-invite-error hidden>{% t "conversation.inviteFailed" %}</p>
    </section>
  {% endif %}

  <section class="bl-card" data-conversation-leave>
    <h2 class="bl-card__title">{% t "conversation.leaveTitle" %}</h2>
    <label class="bl-check">
      <input type="checkbox" data-leave-block />
      {% t "conversation.leaveBlock" %}
    </label>
    <button class="bl-button bl-button--quiet" type="button" data-conversation-leave data-confirm="{% t "conversation.leaveConfirm" %}">{% t "conversation.leave" %}</button>
    <p class="bl-error-text" data-leave-error hidden>{% t "conversation.leaveFailed" %}</p>
  </section>

  </aside>
  </div>

  <p class="bl-error-text" data-conversation-error hidden>{% t "conversation.updateFailed" %}</p>
</main>
{{ footer }}
