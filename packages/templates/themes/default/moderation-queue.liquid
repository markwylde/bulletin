{{ header }}
<main id="main" class="bl-main" data-moderation-queue
  data-label-approve="{% t "moderation.queue.approve" %}"
  data-label-reject="{% t "moderation.queue.reject" %}"
  data-label-approved="{% t "moderation.queue.approved" %}"
  data-label-rejected="{% t "moderation.queue.rejected" %}"
  data-label-failed="{% t "moderation.queue.failed" %}"
  data-label-nothing="{% t "moderation.queue.nothingSelected" %}">
  {{ breadcrumbs }}
  <header class="bl-page-header">
    <div class="bl-page-header__text">
      <h1 class="bl-page__title">{{ title }}</h1>
      <p class="bl-page-header__meta"><span>{% t "moderation.queue.intro" %}</span> <span class="bl-nowrap">· {% t "moderation.queue.pending" %} <strong data-moderation-count>{{ total }}</strong></span></p>
    </div>
  </header>
  <nav class="bl-subnav" aria-label="{% t "moderation.nav.label" %}" data-moderation-nav>
    <a class="bl-subnav__link" href="/moderation/queue" aria-current="page">{% t "moderation.queue.title" %}</a>
    <a class="bl-subnav__link" href="/moderation/reports" data-reports-link>{% t "report.centre.title" %}</a>
    <a class="bl-subnav__link" href="/moderation/log" data-modlog-link>{% t "modlog.title" %}</a>
  </nav>

  <div class="bl-bulk-bar bl-moderation-actions">
    <label class="bl-check"><input type="checkbox" data-moderation-select-all /> {% t "moderation.queue.selectAll" %}</label>
    <div class="bl-bulk-bar__actions">
      <button class="bl-button bl-button--small" type="button" data-moderation-approve disabled>{% t "moderation.queue.approve" %}</button>
      <button class="bl-button bl-button--quiet bl-button--small" type="button" data-moderation-reject disabled>{% t "moderation.queue.reject" %}</button>
    </div>
  </div>
  <p class="bl-muted" data-moderation-status hidden></p>

  {% if hasItems %}
    <ul class="bl-moderation-list" data-moderation-list>
      {% for item in items %}
        <li class="bl-moderation-item" data-moderation-item="{{ item.postId }}">
          <label class="bl-check bl-moderation-item__check">
            <input type="checkbox" data-moderation-check value="{{ item.postId }}" aria-label="{% t "moderation.bulk.select" %}" />
          </label>
          <div class="bl-moderation-item__main">
            <div class="bl-moderation-item__head">
              <span class="bl-badge">{% if item.kind == "topic" %}{% t "moderation.queue.kindTopic" %}{% else %}{% t "moderation.queue.kindPost" %}{% endif %}</span>
              <a class="bl-moderation-item__title" href="{{ item.href }}" data-moderation-topic="{{ item.postId }}">{{ item.title }}</a>
            </div>
            <p class="bl-moderation-item__preview">{{ item.preview }}</p>
            <p class="bl-moderation-item__meta">{{ item.author }} · {{ item.forumTitle }} · {{ item.reason }} · {{ item.createdAt }}</p>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div data-moderation-empty>{{ emptyState }}</div>
  {% endif %}
</main>
{{ footer }}
