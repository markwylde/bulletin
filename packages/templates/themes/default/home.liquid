{{ header }}
<main id="main" class="bl-main" data-online hidden data-board-index data-overlay-ctx="board">
  <section class="bl-card">
    <h1 class="bl-page__title" data-i18n="user.placeholder.title" data-board-name>{{ boardName }}</h1>
    <p class="bl-muted" data-i18n="user.placeholder.body" data-board-description>{{ boardDescription }}</p>
    <div class="bl-actions" data-auth data-auth-state="loading">
      <button type="button" class="bl-button" data-login data-i18n="auth.login" hidden>{% t "auth.login" %}</button>
      <p data-signed-in hidden>
        <span data-i18n="auth.signedIn">{% t "auth.signedIn" %}</span>
        <span data-display-name></span>
      </p>
      <button type="button" class="bl-button" data-logout data-i18n="auth.logout" hidden>{% t "auth.logout" %}</button>
      <p class="bl-error-text" data-auth-error data-i18n="auth.loginError" hidden>{% t "auth.loginError" %}</p>
      <p class="bl-error-text" data-logout-error data-i18n="auth.logoutError" hidden>{% t "auth.logoutError" %}</p>
    </div>
    <div class="bl-card" data-reauth hidden>
      <p data-i18n="auth.reauthPrompt">{% t "auth.reauthPrompt" %}</p>
      <div class="bl-actions">
        <button type="button" class="bl-button" data-reauth-continue data-i18n="auth.continue">{% t "auth.continue" %}</button>
        <button type="button" class="bl-button bl-button--quiet" data-resume data-i18n="auth.resume" hidden>{% t "auth.resume" %}</button>
      </div>
    </div>
  </section>

  {% if flags.announcements and announcements.size > 0 %}
    <section class="bl-announcements" data-announcements aria-label="{% t "forum.announcements" %}">
      {% for announcement in announcements %}
        <article class="bl-card bl-announcement" data-announcement="{{ announcement.id }}">
          <h2 class="bl-announcement__title">{{ announcement.title }}</h2>
          <p class="bl-announcement__body">{{ announcement.body }}</p>
          {% if announcement.dismissible %}
            <button type="button" class="bl-button bl-button--quiet bl-button--small" data-announcement-dismiss="{{ announcement.id }}" data-overlay-member-only hidden>{% t "announcement.dismiss" %}</button>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}

  <button class="bl-button bl-button--quiet bl-button--small" type="button" data-mark-board-read data-overlay-member-only hidden>{% t "read.markBoard" %}</button>

  {% if rootForums.size > 0 %}
    <ul class="bl-forum-list" data-root-forums>
      {% for forum in rootForums %}
        <li class="bl-forum-list__item" data-forum-row="{{ forum.id }}" data-overlay-forum="{{ forum.id }}">
          <div class="bl-forum-row__main">
            <a class="bl-forum-list__link" href="{{ forum.href }}" data-forum-link="{{ forum.id }}">{{ forum.title }}</a>
            {% if forum.description.size > 0 %}
              <p class="bl-muted" data-forum-description>{{ forum.description }}</p>
            {% endif %}
            {% if forum.redirect %}
              <p class="bl-muted" data-redirect>
                <a href="{{ forum.redirect.url }}" rel="nofollow noopener">{{ forum.redirect.url }}</a>
                <span class="bl-badge" data-redirect-clicks="{{ forum.id }}" data-redirect-count="{{ forum.redirect.count }}" data-click-suffix-one="{% t "index.clickSuffix.one" %}" data-click-suffix-other="{% t "index.clickSuffix.other" %}">{{ forum.redirect.clicks }}</span>
              </p>
            {% endif %}
            {% if forum.subforums.size > 0 %}
              <ul class="bl-subforum-list" data-subforums="{{ forum.id }}" aria-label="{% t "index.subforums" %}">
                {% for subforum in forum.subforums %}
                  <li><a href="{{ subforum.href }}" data-subforum-link="{{ subforum.id }}">{{ subforum.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <div class="bl-forum-row__stats">
            <span data-topic-count="{{ forum.id }}">{{ forum.topicCount }}</span>
            <span data-post-count="{{ forum.id }}">{{ forum.postCount }}</span>
            <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ forum.id }}">—</span>
            {% if forum.lastPost %}
              <span class="bl-muted" data-last-post="{{ forum.id }}">
                {% if forum.lastPost.memberName %}
                  {% t "index.lastPostBy" date: forum.lastPost.date, member: forum.lastPost.memberName %}
                {% else %}
                  {% t "index.lastPost" date: forum.lastPost.date %}
                {% endif %}
              </span>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if categories.size > 0 %}
    {% for category in categories %}
      <section class="bl-board-category" data-category="{{ category.id }}" data-overlay-forum="{{ category.id }}">
        <header class="bl-board-category__header">
          <h2 class="bl-board-category__title">
            <a href="{{ category.href }}" data-category-link="{{ category.id }}">{{ category.title }}</a>
            <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ category.id }}">—</span>
          </h2>
          {% if category.description.size > 0 %}
            <p class="bl-muted" data-category-description>{{ category.description }}</p>
          {% endif %}
        </header>
        <ul class="bl-forum-list" data-category-forums="{{ category.id }}">
          {% for forum in category.forums %}
            <li class="bl-forum-list__item" data-forum-row="{{ forum.id }}" data-overlay-forum="{{ forum.id }}">
              <div class="bl-forum-row__main">
                <a class="bl-forum-list__link" href="{{ forum.href }}" data-forum-link="{{ forum.id }}">{{ forum.title }}</a>
                {% if forum.description.size > 0 %}
                  <p class="bl-muted" data-forum-description>{{ forum.description }}</p>
                {% endif %}
                {% if forum.redirect %}
                  <p class="bl-muted" data-redirect>
                    <a href="{{ forum.redirect.url }}" rel="nofollow noopener">{{ forum.redirect.url }}</a>
                    <span class="bl-badge" data-redirect-clicks="{{ forum.id }}" data-redirect-count="{{ forum.redirect.count }}" data-click-suffix-one="{% t "index.clickSuffix.one" %}" data-click-suffix-other="{% t "index.clickSuffix.other" %}">{{ forum.redirect.clicks }}</span>
                  </p>
                {% endif %}
                {% if forum.subforums.size > 0 %}
                  <ul class="bl-subforum-list" data-subforums="{{ forum.id }}" aria-label="{% t "index.subforums" %}">
                    {% for subforum in forum.subforums %}
                      <li><a href="{{ subforum.href }}" data-subforum-link="{{ subforum.id }}">{{ subforum.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
              <div class="bl-forum-row__stats">
                <span data-topic-count="{{ forum.id }}">{{ forum.topicCount }}</span>
                <span data-post-count="{{ forum.id }}">{{ forum.postCount }}</span>
                <span class="bl-overlay-slot" data-overlay-forum-unread data-overlay-forum-id="{{ forum.id }}">—</span>
                {% if forum.lastPost %}
                  <span class="bl-muted" data-last-post="{{ forum.id }}">
                    {% if forum.lastPost.memberName %}
                      {% t "index.lastPostBy" date: forum.lastPost.date, member: forum.lastPost.memberName %}
                    {% else %}
                      {% t "index.lastPost" date: forum.lastPost.date %}
                    {% endif %}
                  </span>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  {% endif %}

  {% if categories.size == 0 and rootForums.size == 0 %}
    {{ emptyState }}
  {% endif %}
</main>
<main class="bl-main" data-offline hidden>
  <section class="bl-card">
    <h1 class="bl-page__title" data-i18n="board.offline.title">{% t "board.offline.title" %}</h1>
    <p class="bl-muted" data-offline-message>{% t "board.offline.defaultMessage" %}</p>
    <div class="bl-actions">
      <a class="bl-button" data-offline-login data-i18n="board.offline.signIn" href="/auth/login">{% t "board.offline.signIn" %}</a>
    </div>
  </section>
</main>
{{ footer }}
