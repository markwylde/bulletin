<a class="bl-skip-link" href="#main">{% t "theme.skipToContent" %}</a>
{% comment %}
  The header is shared HTML: a member and a guest with the same capabilities get identical bytes
  (ADR 0006). Everything personal (counts, the member menu, the sign-in button) is revealed or
  filled in per request by the shell scripts.
{% endcomment %}
<header class="bl-header" data-theme-header data-shell-header{% if flags.realtime %} data-realtime{% endif %}>
  <div class="bl-header__bar">
    <div class="bl-header__inner">
      <button class="bl-icon-button bl-header__menu-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="bl-header-collapse" aria-label="{% t "theme.menu" %}">
        <svg class="bl-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5.5h14M3 10h14M3 14.5h14" /></svg>
      </button>

      <a class="bl-header__brand" href="/">
        <span class="bl-header__mark" aria-hidden="true">{{ boardName | slice: 0 | upcase }}</span>
        <span class="bl-header__name" data-board-name>{{ boardName }}</span>
      </a>

      <div class="bl-header__collapse" id="bl-header-collapse" data-nav-panel>
        {% if flags.search %}
        <form class="bl-search" method="get" action="/search" role="search" data-quick-search>
          <label class="bl-sr-only" for="bl-quick-search-input">{% t "search.quick.label" %}</label>
          <svg class="bl-icon bl-search__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.75" cy="8.75" r="5.25" /><path d="m12.75 12.75 4 4" /></svg>
          <input class="bl-search__input" id="bl-quick-search-input" type="search" name="q"
            maxlength="200" placeholder="{% t "search.quick.placeholder" %}" autocomplete="off" data-quick-search-input>
          <button class="bl-sr-only" type="submit" data-quick-search-submit>{% t "search.quick.submit" %}</button>
        </form>
        {% endif %}

        <nav class="bl-header__nav" aria-label="{% t "theme.nav" %}" data-primary-nav>
          <ul class="bl-nav">
            <li><a class="bl-nav__link" href="/" data-nav-link="forums">{% t "theme.nav.forums" %}</a></li>
            {% if flags.search %}
            <li data-overlay-member-only hidden><a class="bl-nav__link" href="/search/new" data-new-content-link data-nav-link="new">{% t "search.new.crumb" %}</a></li>
            {% endif %}
            {% if flags.member_directory %}
            <li><a class="bl-nav__link" href="/members" data-nav-link="members">{% t "members.title" %}</a></li>
            {% endif %}
            {% if flags.whos_online %}
            <li><a class="bl-nav__link" href="/members/online" data-nav-link="online">{% t "theme.nav.online" %}</a></li>
            {% endif %}
            {% if flags.leaderboards %}
            <li><a class="bl-nav__link" href="/leaderboards" data-nav-link="leaderboards">{% t "leaderboards.title" %}</a></li>
            {% endif %}
          </ul>
        </nav>
      </div>

      <div class="bl-header__actions">
        {% if flags.search %}
        <a class="bl-icon-button bl-header__search-link" href="/search" aria-label="{% t "search.quick.label" %}">
          <svg class="bl-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.75" cy="8.75" r="5.25" /><path d="m12.75 12.75 4 4" /></svg>
        </a>
        {% endif %}
        <span class="bl-header__counts" data-overlay-counts data-overlay-member-only hidden>
        {% if flags.conversations %}
        <a class="bl-icon-button" href="/conversations" data-conversations-link data-overlay-member-only hidden aria-label="{% t "theme.conversations" %}" title="{% t "theme.conversations" %}">
          <svg class="bl-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="2.75" y="4.25" width="14.5" height="11.5" rx="2" /><path d="m3.5 5.5 6.5 5 6.5-5" /></svg>
          <span class="bl-count" data-overlay-count="conversations" data-label="{% t "theme.conversations" %}" hidden></span>
        </a>
        {% endif %}
        {% if flags.notifications %}
        <a class="bl-icon-button" href="/account/notifications" data-notifications-link data-overlay-member-only hidden aria-label="{% t "theme.notifications" %}" title="{% t "theme.notifications" %}">
          <svg class="bl-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5.25 8.5a4.75 4.75 0 0 1 9.5 0v2.9l1.5 2.6H3.75l1.5-2.6Z" /><path d="M8 16.25a2.1 2.1 0 0 0 4 0" /></svg>
          <span class="bl-count" data-overlay-count="notifications" data-label="{% t "theme.notifications" %}" hidden></span>
        </a>
        {% endif %}
        </span>

        <div class="bl-account" data-auth data-auth-state="loading">
          <button class="bl-button bl-button--primary bl-button--small bl-account__login" type="button" data-login hidden>{% t "auth.login" %}</button>
          <div class="bl-account__member" data-signed-in hidden>
            <button class="bl-account__trigger" type="button" data-account-menu-toggle aria-haspopup="true" aria-expanded="false" aria-controls="bl-account-menu">
              <span class="bl-account__avatar" data-header-avatar aria-hidden="true"></span>
              <span class="bl-account__name" data-display-name></span>
              <svg class="bl-icon bl-account__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m6 8 4 4 4-4" /></svg>
            </button>
            <div class="bl-menu bl-account__menu" id="bl-account-menu" data-account-menu hidden>
              <a class="bl-menu__item" href="/account" data-account-profile-link>{% t "theme.account.profile" %}</a>
              <a class="bl-menu__item" href="/account" data-account-link data-overlay-member-only hidden>{% t "theme.account" %}</a>
              {% if flags.notifications %}<a class="bl-menu__item" href="/account/notifications">{% t "theme.notifications" %}</a>{% endif %}
              {% if flags.follows %}<a class="bl-menu__item" href="/account/follows">{% t "theme.account.follows" %}</a>{% endif %}
              {% if flags.conversations %}<a class="bl-menu__item" href="/conversations">{% t "theme.conversations" %}</a>{% endif %}
              <hr class="bl-menu__separator">
              <button class="bl-menu__item" type="button" data-logout>{% t "auth.logout" %}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bl-header__notices">
    <div class="bl-notice bl-notice--danger" role="alert" data-auth-error hidden><p>{% t "auth.loginError" %}</p></div>
    <div class="bl-notice bl-notice--danger" role="alert" data-logout-error hidden><p>{% t "auth.logoutError" %}</p></div>
    <div class="bl-notice bl-notice--warning" data-reauth hidden>
      <p>{% t "auth.reauthPrompt" %}</p>
      <div class="bl-notice__actions">
        <button type="button" class="bl-button bl-button--small" data-reauth-continue>{% t "auth.continue" %}</button>
        <button type="button" class="bl-button bl-button--ghost bl-button--small" data-resume hidden>{% t "auth.resume" %}</button>
      </div>
    </div>
    <div class="bl-notice bl-notice--warning bl-reauth-banner" data-stream-reauth hidden>
      <p>{% t "realtime.reauthBody" %}</p>
      <div class="bl-notice__actions">
        <a class="bl-button bl-button--small" data-stream-reauth-continue href="/api/auth/refresh">{% t "realtime.continue" %}</a>
      </div>
    </div>
    {% if flags.pwa %}
    <div class="bl-notice bl-offline-drafts" data-offline-drafts hidden
      data-label-offline="{% t "pwa.drafts.offline" %}"
      data-label-online="{% t "pwa.drafts.online" %}"
      data-label-send="{% t "pwa.drafts.send" %}"
      data-label-discard="{% t "pwa.drafts.discard" %}"
      data-label-sending="{% t "pwa.drafts.sending" %}">
      <p data-offline-drafts-message></p>
      <div class="bl-notice__actions">
        <button class="bl-button bl-button--small" type="button" data-offline-drafts-send>{% t "pwa.drafts.send" %}</button>
        <button class="bl-button bl-button--ghost bl-button--small" type="button" data-offline-drafts-discard>{% t "pwa.drafts.discard" %}</button>
      </div>
    </div>
    {% endif %}
    {% island "LocaleSuggestion" localeSuggestion %}
    <div class="bl-notice bl-notice--danger bl-ban-notice" data-ban-notice data-label-ban="{% t "ban.notice" reason: "__REASON__", until: "__UNTIL__" %}" data-label-ban-until="{% t "ban.until" date: "__DATE__" %}" hidden></div>
  </div>
</header>
