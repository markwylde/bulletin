<a class="bl-skip-link" href="#main">{% t "theme.skipToContent" %}</a>
<header class="bl-header" data-theme-header{% if flags.realtime %} data-realtime{% endif %}>
  <div class="bl-header__inner">
    <a class="bl-header__brand" href="/" data-board-name>{{ boardName }}</a>
    <nav class="bl-header__nav" aria-label="{% t "theme.nav" %}">
      {% comment %}Membership-dependent UI stays out of shared HTML: the per-request shell unhides it.{% endcomment %}
      <a class="bl-header__link" href="/account" data-account-link data-overlay-member-only hidden>{% t "theme.account" %}</a>
      {% if flags.conversations %}<a class="bl-header__link" href="/conversations" data-conversations-link data-overlay-member-only hidden>{% t "conversation.title" %}</a>{% endif %}
      {% comment %}Counts come from the overlay, so the shared header stays identical.{% endcomment %}
      {% if flags.notifications %}
      <a class="bl-header__bell" href="/account/notifications" data-notifications-link data-overlay-member-only hidden aria-label="{% t "theme.notifications" %}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3a5 5 0 0 0-5 5v3.6L5.4 15h13.2L17 11.6V8a5 5 0 0 0-5-5zm0 18a2.5 2.5 0 0 0 2.4-2H9.6A2.5 2.5 0 0 0 12 21z" /></svg>
        <span class="bl-header__count" data-overlay-count="notifications" data-label="{% t "theme.notifications" %}" hidden></span>
      </a>
      {% endif %}
      <span class="bl-header__counts" data-overlay-counts data-overlay-member-only hidden>
        <span class="bl-header__count" data-overlay-count="conversations" data-label="{% t "theme.conversations" %}" hidden></span>
      </span>
      {% island "LanguageSwitcher" language %}
    </nav>
  </div>
  {% if flags.realtime %}
  <div class="bl-reauth-banner" data-stream-reauth hidden>
    <p>{% t "realtime.reauthBody" %}</p>
    <a class="bl-button bl-button--small" data-stream-reauth-continue href="/api/auth/refresh">{% t "realtime.continue" %}</a>
  </div>
  {% endif %}
  {% island "LocaleSuggestion" localeSuggestion %}
  <div class="bl-ban-notice" data-ban-notice data-label-ban="{% t "ban.notice" reason: "__REASON__", until: "__UNTIL__" %}" data-label-ban-until="{% t "ban.until" date: "__DATE__" %}" hidden></div>
</header>
