{{ header }}
<main id="main" class="bl-main" data-leaderboards-page data-overlay-ctx="board">
  {{ breadcrumbs }}
  <h1 class="bl-page__title">{% t "leaderboards.title" %}</h1>
  <p class="bl-muted">{% t "leaderboards.intro" %}</p>

  {% for board in boards %}
    <section class="bl-card" data-leaderboard="{{ board.period }}-{{ board.metric }}">
      <h2 class="bl-card__title">{{ board.title }}</h2>
      {% if board.entries.size > 0 %}
        <ol class="bl-leaderboard">
          {% for entry in board.entries %}
            <li class="bl-leaderboard__row" data-leaderboard-entry="{{ entry.memberId }}">
              <span class="bl-leaderboard__rank">{{ entry.rank }}</span>
              <a href="{{ entry.href }}"{% if entry.groupColour %} style="color: {{ entry.groupColour }}"{% endif %}>{{ entry.name }}</a>
              <span class="bl-muted">{{ entry.value }}</span>
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p class="bl-muted">{% t "leaderboards.empty" %}</p>
      {% endif %}
    </section>
  {% endfor %}
</main>
{{ footer }}
