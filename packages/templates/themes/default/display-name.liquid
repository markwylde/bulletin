{{ header }}
<main id="main" class="bl-main" data-display-name-step data-auth-state="authenticated">
  {{ breadcrumbs }}
  <section class="bl-state bl-state--panel bl-state--form">
    <svg class="bl-state__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.75" /><path d="M4.75 19.25a7.25 7.25 0 0 1 14.5 0" /></svg>
    <h1 class="bl-state__title">{% t "displayName.title" %}</h1>
    <p class="bl-state__body">{% t "displayName.help" %}</p>
    <form class="bl-form" data-display-name-form data-return-to="{{ returnTo }}">
      <label class="bl-label" for="display-name">{% t "displayName.label" %}</label>
      <input class="bl-input" id="display-name" name="displayName" data-display-name-input autocomplete="nickname" minlength="3" maxlength="32" required />
      <button class="bl-button bl-button--primary bl-button--block" type="submit" data-display-name-submit>{% t "displayName.save" %}</button>
      <p class="bl-error-text" data-display-name-error hidden></p>
    </form>
  </section>
</main>
{{ footer }}
