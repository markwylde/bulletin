{% if items.size > 0 %}
  <nav class="bl-breadcrumbs" aria-label="{% t "theme.breadcrumbs" %}" data-breadcrumbs>
    <ol class="bl-breadcrumbs__list">
      <li class="bl-breadcrumbs__item"><a class="bl-breadcrumbs__link" href="/">{% t "theme.home" %}</a></li>
      {% for item in items %}
        <li class="bl-breadcrumbs__item{% if forloop.last %} bl-breadcrumbs__item--current{% endif %}">
          <svg class="bl-breadcrumbs__separator" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m6.5 4 4 4-4 4" /></svg>
          {% if item.href %}
            <a class="bl-breadcrumbs__link" href="{{ item.href }}">{{ item.label }}</a>
          {% else %}
            <span class="bl-breadcrumbs__current" aria-current="page">{{ item.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
