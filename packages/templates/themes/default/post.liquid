        <li class="bl-post{% if post.deleted %} bl-post--deleted{% endif %}" id="post-{{ post.id }}" data-post="{{ post.id }}" data-post-position="{{ post.position }}"{% if post.authorId %} data-author="{{ post.authorId }}"{% endif %}
          data-label-edit="{% t "post.edit" %}" data-label-body="{% t "post.body" %}"
          data-label-redact="{% t "post.redact" %}" data-label-save="{% t "post.save" %}"
          data-label-edit-failed="{% t "post.editFailed" %}" data-label-delete="{% t "post.delete" %}"
          data-label-confirm-delete="{% t "post.confirmDelete" %}">
          <div class="bl-post__author">
            {{ post.authorCard }}
            {% hook "post.userbar" %}
          </div>
          <div class="bl-post__main">
            <div class="bl-post__ignored" data-post-ignored hidden>
              <p>{% t "profile.ignore.collapsed" %}</p>
              <button class="bl-button bl-button--quiet bl-button--small" type="button" data-post-reveal>{% t "profile.ignore.reveal" %}</button>
            </div>
            <div class="bl-post__meta">
              {% if post.canBulk %}
                <label class="bl-check bl-post__select">
                  <input type="checkbox" data-bulk-post-check="{{ post.id }}" value="{{ post.id }}" aria-label="{% t "moderation.bulk.select" %}" />
                </label>
              {% endif %}
              <span class="bl-muted" data-post-time>{{ post.createdAt }}</span>
              {% if post.unapproved %}<span class="bl-badge bl-badge--danger" data-post-unapproved>{% t "post.unapproved" %}</span>{% endif %}
              {% if post.editedMarker %}<span class="bl-muted" data-post-edited>{{ post.editedMarker }}</span>{% endif %}
              <a class="bl-muted" href="{{ post.href }}" data-post-link="{{ post.id }}">{% t "post.permalink" %}</a>
              <button class="bl-button bl-button--quiet bl-button--small" type="button" data-quote-post="{{ post.id }}" aria-pressed="false">{% t "post.quote" %}</button>
              <button class="bl-button bl-button--quiet bl-button--small" type="button" data-report-post="{{ post.id }}" data-overlay-member-only hidden>{% t "report.reportPost" %}</button>
              {% if flags.warnings and post.canWarn %}<a class="bl-button bl-button--quiet bl-button--small" href="/moderation/warnings/{{ post.authorId }}?post={{ post.id }}" data-warn-post="{{ post.id }}">{% t "warnings.warnPost" %}</a>{% endif %}
              {% if flags.reputation %}<bl-post-reputation data-post="{{ post.id }}"></bl-post-reputation>{% endif %}
              {% if post.canViewHistory %}
                <button class="bl-button bl-button--quiet bl-button--small" type="button" data-post-history="{{ post.id }}">{% t "post.history" %}</button>
              {% endif %}
              {% if post.canDelete %}
                <button class="bl-button bl-button--quiet bl-button--small" type="button" data-post-action="soft" data-post-id="{{ post.id }}" data-confirm="{% t "post.confirmDelete" %}">{% t "post.delete" %}</button>
              {% endif %}
              {% if post.canRestore %}
                <button class="bl-button bl-button--quiet bl-button--small" type="button" data-post-action="restore" data-post-id="{{ post.id }}">{% t "post.restore" %}</button>
              {% endif %}
              {% if post.canHardDelete %}
                <button class="bl-button bl-button--quiet bl-button--small" type="button" data-post-action="hard" data-post-id="{{ post.id }}" data-confirm="{% t "post.confirmHardDelete" %}">{% t "post.hardDelete" %}</button>
              {% endif %}
            </div>
            {% if post.canEdit %}
              <details class="bl-post__edit" data-post-edit="{{ post.id }}">
                <summary>{% t "post.edit" %}</summary>
                <form class="bl-topic-form" data-edit-form data-post-id="{{ post.id }}">
                  <label class="bl-label" for="edit-body-{{ post.id }}">{% t "post.body" %}</label>
                  <textarea class="bl-input" id="edit-body-{{ post.id }}" name="bodyMd" rows="6" required>{{ post.editBody }}</textarea>
                  {% if post.canRedact %}
                    <label class="bl-check"><input type="checkbox" name="redact" checked /> {% t "post.redact" %}</label>
                  {% endif %}
                  <button class="bl-button" type="submit" data-edit-submit>{% t "post.save" %}</button>
                  <p class="bl-error-text" data-form-error hidden>{% t "post.editFailed" %}</p>
                </form>
              </details>
            {% endif %}
            <div class="bl-post__history" data-post-history-panel="{{ post.id }}" hidden
              data-label-from="{% t "post.historyFrom" %}" data-label-to="{% t "post.historyTo" %}"
              data-label-version="{% t "post.historyVersion" %}"></div>
            {% if post.deleted %}
              <details class="bl-post__deleted" data-post-deleted>
                <summary>{% t "post.deleted" %}</summary>
                <div class="bl-post__body">{{ post.body }}</div>
              </details>
            {% else %}
              <div class="bl-post__body" data-post-body>{{ post.body }}</div>
            {% endif %}
            {% if flags.attachments and post.files %}
              <div class="bl-post__attachments" data-post-files="{{ post.id }}">{{ post.files }}</div>
            {% endif %}
            {% if post.authorId %}<bl-post-signature data-member="{{ post.authorId }}"></bl-post-signature>{% endif %}
            {% if flags.reactions %}<bl-post-reactions data-post="{{ post.id }}"></bl-post-reactions>{% endif %}
          </div>
        </li>
