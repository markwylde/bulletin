{{ header }}
<main id="main" class="bl-main" data-warnings-page data-points="{{ points }}"
  data-label-ack-failed="{% t "warnings.ack.failed" %}"
  data-label-ack-saved="{% t "warnings.ack.saved" %}">
  {{ breadcrumbs }}
  <div class="bl-account-layout">
    {{ accountNav }}
    <div class="bl-account-layout__main">
    <header class="bl-page__header">
      <h1 class="bl-page__title">{{ title }}</h1>
      <p class="bl-muted">{% t "warnings.points" count: points %}</p>
      {% if pendingAck %}
        <div class="bl-card bl-warning-ack" data-warning-ack>
          <p>{% t "warnings.ack.required" %}</p>
          <button class="bl-button" type="button" data-warning-ack-button>{% t "warnings.ack.button" %}</button>
          <p class="bl-error-text" data-warning-ack-error hidden></p>
        </div>
      {% endif %}
      {% if restrictions.size > 0 %}
        <section class="bl-card" data-warning-restrictions>
          <h2 class="bl-card__title">{% t "warnings.restrictions.title" %}</h2>
          <ul>
            {% for restriction in restrictions %}
              <li data-warning-restriction="{{ restriction.kind }}">
                {{ restriction.label }}{% if restriction.until %} — {% t "warnings.restrictions.until" date: restriction.until %}{% endif %}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </header>

    {% if hasWarnings %}
      <ul class="bl-warning-list" data-warning-list>
        {% for warning in warnings %}
          <li class="bl-card bl-warning" data-warning-id="{{ warning.id }}" data-warning-revoked="{{ warning.revoked }}">
            <div class="bl-warning__meta">
              <span class="bl-badge">{{ warning.reason }}</span>
              <span class="bl-muted">{% t "warnings.pointsValue" count: warning.points %}</span>
              <span class="bl-muted">{% t "warnings.expires" date: warning.expiresAt %}</span>
              {% if warning.revoked %}<span class="bl-badge bl-badge--danger">{% t "warnings.revoked" %}</span>{% endif %}
            </div>
            {% if warning.memberNote != "" %}<p>{{ warning.memberNote }}</p>{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <section class="bl-empty" data-theme-empty data-warnings-empty>
        <svg class="bl-empty__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6Z" /><path d="m9 12 2 2 4-4" /></svg>
        <h2 class="bl-empty__title">{% t "warnings.empty.title" %}</h2>
        <p class="bl-empty__body">{% t "warnings.empty.body" %}</p>
      </section>
    {% endif %}
    </div>
  </div>
</main>
{{ footer }}
