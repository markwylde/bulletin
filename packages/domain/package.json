    "./auth": "./src/auth/index.ts",
    "./permissions": "./src/permissions/index.ts",
    "./permissions/fixtures": "./src/permissions/fixtures.ts",
    "./forums": "./src/forums/index.ts",
    "./leaderboards": "./src/leaderboards/index.ts",
    "./auth/browser": "./src/auth/browser.ts",
    "./auth/silent": "./src/auth/silent.ts",
    "./member": "./src/member/index.ts",
    "./net": "./src/net/index.ts",
    "./urls": "./src/urls/index.ts",
    "./badges": "./src/badges/index.ts",
    "./board": "./src/board/index.ts",
    "./events": "./src/events/index.ts",
    "./follows": "./src/follows/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./mutations": "./src/mutations/index.ts",
    "./visits": "./src/visits/index.ts",
    "./content": "./src/content/index.ts",
    "./topics": "./src/topics/index.ts",
    "./polls": "./src/polls/index.ts",
    "./presence": "./src/presence/index.ts",
    "./profiles": "./src/profiles/index.ts",
    "./ranks": "./src/ranks/index.ts",
    "./reactions": "./src/reactions/index.ts",
    "./relationships": "./src/relationships/index.ts",
    "./reputation": "./src/reputation/index.ts",
    "./attachments": "./src/attachments/index.ts",
    "./attachments/processing": "./src/attachments/processing.ts",
    "./events/stream": "./src/events/stream.ts"
