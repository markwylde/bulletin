  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bulletin/cache": "workspace:*",
    "@bulletin/i18n": "workspace:*",
    "@bulletin/storage": "workspace:*",
    "@darkauth/client": "1.32.0",
    "file-type": "21.0.0",
    "jose": "6.2.16",
    "@bulletin/content": "workspace:*",
    "parse5": "8.1.1",
    "sharp": "0.35.5"
